      "html": "<div class=\"bg-[#201b2d] text-white font-['Fira_Sans'] min-h-screen relative overflow-x-clip selection:bg-[#cff75e] selection:text-[#201b2d]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Dot Grid Texture -->\n    <div class=\"fixed inset-0 opacity-[0.03] pointer-events-none\" data-kid=\"1-1\" data-name=\"dot grid texture background\" style=\"background-image: radial-gradient(#cff75e 2px, transparent 2px); background-size: 60px 60px;\">\n    </div>\n    <!-- Header / Nav -->\n    <header class=\"fixed top-0 w-full z-100 px-6 md:px-12 py-8 flex items-center justify-between border-b border-white/5 bg-[#201b2d]/90 backdrop-blur-xl\" data-kid=\"1-2\" data-name=\"main navigation header\">\n        <div class=\"flex items-center gap-12\" data-kid=\"1-2-1\" data-name=\"navigation branding and menu container\">\n            <a class=\"font-['Space_Grotesk'] text-2xl font-bold tracking-tighter hover:opacity-80 transition-opacity\" data-kid=\"1-2-1-1\" data-name=\"site brand name\" href=\"#\">\n                FLOW\n                <span class=\"text-[#cff75e]\" data-kid=\"1-2-1-1-1\" data-name=\"site brand name suffix\">\n                    LINE\n                </span>\n            </a>\n            <nav class=\"hidden lg:flex items-center gap-8 text-[11px] font-bold uppercase tracking-[0.2em] text-white/40\" data-kid=\"1-2-1-2\" data-name=\"main navigation menu\">\n                <a class=\"hover:text-white transition-colors\" data-kid=\"1-2-1-2-1\" data-name=\"how it works menu link\" href=\"#\">\n                    How it works\n                </a>\n                <a class=\"hover:text-white transition-colors\" data-kid=\"1-2-1-2-2\" data-name=\"engine menu link\" href=\"#\">\n                    Engine\n                </a>\n                <a class=\"hover:text-white transition-colors\" data-kid=\"1-2-1-2-3\" data-name=\"traces menu link\" href=\"#\">\n                    Traces\n                </a>\n            </nav>\n        </div>\n        <button class=\"bg-[#cff75e] text-[#201b2d] px-6 py-2.5 rounded-sm font-bold text-xs uppercase tracking-widest border border-transparent hover:bg-transparent hover:text-[#cff75e] hover:border-[#cff75e] transition-all duration-300\" data-kid=\"1-2-2\" data-name=\"primary get started header button\">\n            Get Started\n        </button>\n    </header>\n    <main class=\"relative z-10 pt-48 pb-64\" data-kid=\"1-3\" data-name=\"main content area\">\n        <!-- Hero Section -->\n        <section class=\"max-w-7xl mx-auto px-6 md:px-12 mb-40 md:mb-64\" data-kid=\"1-3-1\" data-name=\"hero section\" id=\"hero\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\" data-kid=\"1-3-1-1\" data-name=\"hero layout grid\">\n                <div class=\"hero-text-block\" data-kid=\"1-3-1-1-1\" data-name=\"hero text content block\">\n                    <h1 class=\"hero-title font-['Space_Grotesk'] text-7xl md:text-[9rem] font-bold leading-[0.85] tracking-tighter mb-12\" data-kid=\"1-3-1-1-1-1\" data-name=\"hero main headline\">\n                        Async logic.\n                        <br data-kid=\"1-3-1-1-1-1-1\" data-name=\"line break\"/>\n                        Synced execution.\n                    </h1>\n                    <p class=\"text-xl md:text-2xl text-white/60 max-w-xl mb-12 leading-relaxed\" data-kid=\"1-3-1-1-1-2\" data-name=\"hero subheadline description\">\n                        High-throughput Node.js/BullMQ/PostgreSQL engine for durable workflows. Logic that survives restarts.\n                    </p>\n                    <div class=\"flex flex-wrap gap-6\" data-kid=\"1-3-1-1-1-3\" data-name=\"hero call-to-action buttons container\">\n                        <button class=\"bg-[#cff75e] text-[#201b2d] px-10 py-5 rounded-sm font-bold text-lg border-2 border-[#cff75e] hover:bg-transparent hover:text-[#cff75e] shadow-[0_0_40px_rgba(207,247,94,0.15)]\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"hero get started button\">\n                            Get Started\n                        </button>\n                        <button class=\"bg-white/5 text-white px-10 py-5 rounded-sm font-bold text-lg border-2 border-white/10 hover:bg-white/10 group\" data-kid=\"1-3-1-1-1-3-2\" data-name=\"hero see how it works button\">\n                            See how it works\n                            <i class=\"ti ti-arrow-narrow-right inline-block group-hover:translate-x-1 transition-transform\" data-kid=\"1-3-1-1-1-3-2-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"relative flex justify-center lg:justify-end\" data-kid=\"1-3-1-1-2\" data-name=\"hero visual graphic container\">\n                    <!-- The Trigger Node -->\n                    <div class=\"trigger-node relative w-64 h-64 bg-[#4a416b] border border-[#cff75e]/30 rounded-2xl flex flex-col items-center justify-center group\" data-kid=\"1-3-1-1-2-1\" data-name=\"trigger node element\">\n                        <div class=\"absolute -top-3 left-6 px-3 py-1 bg-[#cff75e] text-[#201b2d] text-[10px] font-black uppercase tracking-widest rounded-xs\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"trigger node label badge\">\n                            Trigger\n                        </div>\n                        <div class=\"w-24 h-24 rounded-full border border-[#cff75e]/40 flex items-center justify-center bg-[#cff75e]/10 group-hover:scale-110 transition-transform duration-500\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"trigger node icon circle\">\n                            <i class=\"ti ti-webhook text-[#cff75e] text-5xl\" data-kid=\"1-3-1-1-2-1-2-1\" data-name=\"webhook icon\">\n                            </i>\n                        </div>\n                        <div class=\"mt-4 text-center\" data-kid=\"1-3-1-1-2-1-3\" data-name=\"trigger node status group\">\n                            <div class=\"text-[10px] font-mono text-white/40 uppercase tracking-widest\" data-kid=\"1-3-1-1-2-1-3-1\" data-name=\"trigger node status label\">\n                                Active Hook\n                            </div>\n                            <div class=\"text-[#cff75e] font-mono font-bold\" data-kid=\"1-3-1-1-2-1-3-2\" data-name=\"trigger node event id text\">\n                                EVENT_LISTEN_04\n                            </div>\n                        </div>\n                        <!-- Readout -->\n                        <div class=\"absolute -bottom-12 right-0 text-right\" data-kid=\"1-3-1-1-2-1-4\" data-name=\"trigger node readout\">\n                            <div class=\"text-[9px] font-mono text-white/30 uppercase tracking-[0.3em] mb-1\" data-kid=\"1-3-1-1-2-1-4-1\" data-name=\"live pipeline label\">\n                                Live Pipeline\n                            </div>\n                            <div class=\"text-[#cff75e] font-mono text-sm font-black flex items-center gap-2 justify-end\" data-kid=\"1-3-1-1-2-1-4-2\" data-name=\"run id readout\">\n                                <span class=\"w-1.5 h-1.5 bg-[#cff75e] rounded-full animate-ping\" data-kid=\"1-3-1-1-2-1-4-2-1\" data-name=\"pulsing connection indicator\">\n                                </span>\n                                RUN 0042\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- The Pipeline Story Container -->\n        <div class=\"relative max-w-7xl mx-auto px-6 md:px-12\" data-kid=\"1-3-2\" data-name=\"pipeline story container\">\n            <!-- Central Spine Line (Guaranteed Alignment) -->\n            <div class=\"absolute left-1/2 top-0 bottom-0 w-1 -translate-x-1/2 hidden md:block z-10\" data-kid=\"1-3-2-1\" data-name=\"central spine line container\">\n                <div class=\"w-full h-full bg-white/5 relative\" data-kid=\"1-3-2-1-1\" data-name=\"central spine bar background\">\n                    <div class=\"absolute top-0 left-0 w-full bg-[#cff75e] shadow-[0_0_15px_#cff75e] origin-top scale-y-0\" data-kid=\"1-3-2-1-1-1\" data-name=\"pipeline rail progress indicator\" id=\"pipeline-rail-draw\">\n                    </div>\n                    <!-- Technical Readout near line -->\n                    <div class=\"sticky top-[50%] -translate-y-1/2 left-4 w-32 hidden lg:block opacity-40\" data-kid=\"1-3-2-1-1-2\" data-name=\"technical readout container\">\n                        <div class=\"text-[8px] font-mono text-white tracking-[0.3em] uppercase mb-1\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"live pipeline label\">\n                            Live Pipeline\n                        </div>\n                        <div class=\"text-[#cff75e] font-mono text-[10px] font-bold\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"run id readout\">\n                            RUN_ID: 0042_PROC\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Rotating Gear Decorative Element -->\n            <div class=\"fixed right-[-5%] top-[20%] opacity-5 pointer-events-none hidden lg:block z-0\" data-kid=\"1-3-2-2\" data-name=\"rotating gear decorative element\" id=\"motion-target-scrub-rotation\">\n                <i class=\"ti ti-settings-2 text-[40rem] text-[#cff75e]\" data-kid=\"1-3-2-2-1\" data-name=\"settings icon\">\n                </i>\n            </div>\n            <!-- Mobile Rail -->\n            <div class=\"absolute left-6 top-0 bottom-0 w-1 bg-[#cff75e]/10 md:hidden z-10\" data-kid=\"1-3-2-3\" data-name=\"mobile rail line\">\n            </div>\n            <!-- Feature Blocks -->\n            <div class=\"space-y-48 md:space-y-80 relative z-20\" data-kid=\"1-3-2-4\" data-name=\"feature blocks container\">\n                <!-- 01: Webhook -->\n                <div class=\"feature-block flex flex-col md:flex-row items-center gap-12\" data-kid=\"1-3-2-4-1\" data-name=\"webhook feature block\" id=\"block-01\">\n                    <div class=\"flex-1 text-right order-1 md:pr-24 lg:pr-32\" data-kid=\"1-3-2-4-1-1\" data-name=\"webhook feature description\">\n                        <div class=\"text-[#cff75e] font-mono text-xs mb-4 tracking-widest font-bold\" data-kid=\"1-3-2-4-1-1-1\" data-name=\"webhook feature phase label\">\n                            01 // INGRESS\n                        </div>\n                        <h2 class=\"font-['Space_Grotesk'] text-4xl md:text-5xl font-bold mb-6\" data-kid=\"1-3-2-4-1-1-2\" data-name=\"webhook feature title\">\n                            Webhook + polling triggers\n                        </h2>\n                        <p class=\"text-white/50 text-lg leading-relaxed max-w-md ml-auto\" data-kid=\"1-3-2-4-1-1-3\" data-name=\"webhook feature description text\">\n                            Ingest events at scale. Low latency ingestion with automated payload validation and deduplication.\n                        </p>\n                    </div>\n                    <div class=\"node-ring w-14 h-14 md:w-20 md:h-20 rounded-full border-4 border-[#cff75e]/20 bg-[#201b2d] relative z-30 flex items-center justify-center order-2\" data-kid=\"1-3-2-4-1-2\" data-name=\"webhook feature node ring\">\n                        <i class=\"ti ti-webhook text-2xl text-[#cff75e]/40 node-icon\" data-kid=\"1-3-2-4-1-2-1\" data-name=\"webhook feature icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 order-3 md:pl-24 lg:pl-32\" data-kid=\"1-3-2-4-1-3\" data-name=\"webhook feature code snippet container\">\n                        <div class=\"bg-[#4a416b] border border-white/10 rounded-xl p-8 shadow-2xl overflow-hidden relative group\" data-kid=\"1-3-2-4-1-3-1\" data-name=\"webhook code block container\">\n                            <div class=\"absolute top-0 right-0 p-3 text-[9px] font-mono text-white/20 uppercase tracking-widest border-l border-b border-white/5\" data-kid=\"1-3-2-4-1-3-1-1\" data-name=\"raw event label\">\n                                Raw Event\n                            </div>\n                            <pre class=\"font-mono text-[10px] md:text-xs text-[#cff75e]/90 leading-relaxed\" data-kid=\"1-3-2-4-1-3-1-2\" data-name=\"webhook json code block\"><code data-kid=\"1-3-2-4-1-3-1-2-1\" data-name=\"webhook json code text\">{\n  \"event\": \"payment.success\",\n  \"actor\": \"user_9921\",\n  \"context\": {\n    \"ip\": \"192.168.1.1\"\n  }\n}</code></pre>\n                        </div>\n                    </div>\n                </div>\n                <!-- 02: Branching -->\n                <div class=\"feature-block flex flex-col md:flex-row items-center gap-12\" data-kid=\"1-3-2-4-2\" data-name=\"branching feature block\" id=\"block-02\">\n                    <div class=\"flex-1 order-3 md:order-1 md:pr-24 lg:pr-32\" data-kid=\"1-3-2-4-2-1\" data-name=\"branching feature visualization container\">\n                        <div class=\"bg-[#4a416b] border border-white/10 rounded-xl p-10 shadow-2xl relative overflow-hidden\" data-kid=\"1-3-2-4-2-1-1\" data-name=\"branching diagram\">\n                            <div class=\"flex flex-col gap-12 items-center\" data-kid=\"1-3-2-4-2-1-1-1\" data-name=\"branching top row\">\n                                <div class=\"w-full flex justify-between items-center relative\" data-kid=\"1-3-2-4-2-1-1-1-1\" data-name=\"branching input node\">\n                                    <div class=\"w-8 h-8 rounded bg-white/10\" data-kid=\"1-3-2-4-2-1-1-1-1-1\">\n                                    </div>\n                                    <div class=\"flex-1 h-px bg-white/20 mx-4 relative overflow-hidden\" data-kid=\"1-3-2-4-2-1-1-1-1-2\">\n                                        <div class=\"absolute inset-0 bg-[#cff75e] origin-left branch-line-anim\" data-kid=\"1-3-2-4-2-1-1-1-1-2-1\">\n                                        </div>\n                                    </div>\n                                    <div class=\"w-12 h-12 rounded bg-[#cff75e] flex items-center justify-center text-[#201b2d] shadow-[0_0_20px_rgba(207,247,94,0.3)]\" data-kid=\"1-3-2-4-2-1-1-1-1-3\">\n                                        <i class=\"ti ti-git-branch\" data-kid=\"1-3-2-4-2-1-1-1-1-3-1\">\n                                        </i>\n                                    </div>\n                                </div>\n                                <div class=\"w-full grid grid-cols-2 gap-8\" data-kid=\"1-3-2-4-2-1-1-1-2\" data-name=\"branching connector\">\n                                    <div class=\"p-6 border border-white/10 rounded-lg bg-white/5 text-center\" data-kid=\"1-3-2-4-2-1-1-1-2-1\" data-name=\"branching connection progress bar\">\n                                        <div class=\"text-[9px] uppercase tracking-widest text-white/40 mb-2\" data-kid=\"1-3-2-4-2-1-1-1-2-1-1\">\n                                            Success\n                                        </div>\n                                        <div class=\"text-[#cff75e] text-xs font-mono\" data-kid=\"1-3-2-4-2-1-1-1-2-1-2\">\n                                            PROCEED\n                                        </div>\n                                    </div>\n                                    <div class=\"p-6 border border-white/10 rounded-lg bg-white/5 text-center\" data-kid=\"1-3-2-4-2-1-1-1-2-2\">\n                                        <div class=\"text-[9px] uppercase tracking-widest text-white/40 mb-2\" data-kid=\"1-3-2-4-2-1-1-1-2-2-1\">\n                                            Failure\n                                        </div>\n                                        <div class=\"text-red-400 text-xs font-mono\" data-kid=\"1-3-2-4-2-1-1-1-2-2-2\">\n                                            RETRY_BACKOFF\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"node-ring w-14 h-14 md:w-20 md:h-20 rounded-full border-4 border-[#cff75e]/20 bg-[#201b2d] relative z-30 flex items-center justify-center order-2\" data-kid=\"1-3-2-4-2-2\" data-name=\"branching feature node ring\">\n                        <i class=\"ti ti-git-branch text-2xl text-[#cff75e]/40 node-icon\" data-kid=\"1-3-2-4-2-2-1\" data-name=\"branching feature icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 order-1 md:order-3 md:pl-24 lg:pl-32 text-left\" data-kid=\"1-3-2-4-2-3\" data-name=\"branching feature description\">\n                        <div class=\"text-[#cff75e] font-mono text-xs mb-4 tracking-widest font-bold\" data-kid=\"1-3-2-4-2-3-1\" data-name=\"branching feature phase label\">\n                            02 // DECISION\n                        </div>\n                        <h2 class=\"font-['Space_Grotesk'] text-4xl md:text-5xl font-bold mb-6\" data-kid=\"1-3-2-4-2-3-2\" data-name=\"branching feature title\">\n                            Conditional branching\n                        </h2>\n                        <p class=\"text-white/50 text-lg leading-relaxed max-w-md\" data-kid=\"1-3-2-4-2-3-3\" data-name=\"branching feature description text\">\n                            Native multi-path execution. Define complex logic trees that resolve state in real-time.\n                        </p>\n                        <!-- Block 05 attached here as requested -->\n                        <div class=\"mt-12 bg-[#4a416b]/60 border border-[#cff75e]/30 rounded-lg p-6 max-w-sm backdrop-blur-md relative shadow-2xl overflow-hidden\" data-kid=\"1-3-2-4-2-3-4\" data-name=\"exponential backoff info card\">\n                            <div class=\"flex items-start gap-4\" data-kid=\"1-3-2-4-2-3-4-1\" data-name=\"backoff info content\">\n                                <div class=\"w-10 h-10 rounded-full bg-[#cff75e]/10 flex items-center justify-center shrink-0\" data-kid=\"1-3-2-4-2-3-4-1-1\" data-name=\"backoff icon container\">\n                                    <i class=\"ti ti-rotate-2 text-[#cff75e] text-lg\" data-kid=\"1-3-2-4-2-3-4-1-1-1\" data-name=\"rotate icon\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"1-3-2-4-2-3-4-1-2\" data-name=\"backoff text\">\n                                    <h4 class=\"text-sm font-bold text-[#cff75e] mb-1\" data-kid=\"1-3-2-4-2-3-4-1-2-1\" data-name=\"backoff title\">\n                                        Exponential backoff\n                                    </h4>\n                                    <p class=\"text-[11px] text-white/50 leading-relaxed\" data-kid=\"1-3-2-4-2-3-4-1-2-2\" data-name=\"backoff description\">\n                                        Idempotent triggers + automated jittered retries ensure no duplicate executions.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- 03: Durable Delays -->\n                <div class=\"feature-block flex flex-col md:flex-row items-center gap-12\" data-kid=\"1-3-2-4-3\" data-name=\"durable delays feature block\" id=\"block-03\">\n                    <div class=\"flex-1 text-right order-1 md:pr-24 lg:pr-32\" data-kid=\"1-3-2-4-3-1\" data-name=\"durable delays feature description\">\n                        <div class=\"text-[#cff75e] font-mono text-xs mb-4 tracking-widest font-bold\" data-kid=\"1-3-2-4-3-1-1\" data-name=\"durable delays phase label\">\n                            03 // PERSISTENCE\n                        </div>\n                        <h2 class=\"font-['Space_Grotesk'] text-4xl md:text-5xl font-bold mb-6\" data-kid=\"1-3-2-4-3-1-2\" data-name=\"durable delays title\">\n                            Durable delay steps\n                        </h2>\n                        <p class=\"text-white/50 text-lg leading-relaxed max-w-md ml-auto\" data-kid=\"1-3-2-4-3-1-3\" data-name=\"durable delays description text\">\n                            PostgreSQL state persistence ensures your workflows resume exactly where they left off, even after a worker restart.\n                        </p>\n                    </div>\n                    <div class=\"node-ring w-14 h-14 md:w-20 md:h-20 rounded-full border-4 border-[#cff75e]/20 bg-[#201b2d] relative z-30 flex items-center justify-center order-2\" data-kid=\"1-3-2-4-3-2\" data-name=\"durable delays node ring\">\n                        <i class=\"ti ti-clock text-2xl text-[#cff75e]/40 node-icon\" data-kid=\"1-3-2-4-3-2-1\" data-name=\"durable delays icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 order-3 md:pl-24 lg:pl-32\" data-kid=\"1-3-2-4-3-3\" data-name=\"durable delays state visualization\">\n                        <div class=\"bg-[#4a416b] border border-white/10 rounded-xl p-8 shadow-2xl flex items-center gap-6 overflow-hidden\" data-kid=\"1-3-2-4-3-3-1\" data-name=\"durable delays status card\">\n                            <div class=\"w-16 h-16 shrink-0 bg-[#201b2d] rounded-lg border border-[#cff75e]/20 flex items-center justify-center\" data-kid=\"1-3-2-4-3-3-1-1\" data-name=\"durable delays database icon container\">\n                                <i class=\"ti ti-database text-[#cff75e] text-2xl\" data-kid=\"1-3-2-4-3-3-1-1-1\" data-name=\"database icon\">\n                                </i>\n                            </div>\n                            <div class=\"flex-1\" data-kid=\"1-3-2-4-3-3-1-2\" data-name=\"durable delays status details\">\n                                <div class=\"flex items-center justify-between mb-2\" data-kid=\"1-3-2-4-3-3-1-2-1\" data-name=\"durable delays status header\">\n                                    <span class=\"text-[10px] font-mono uppercase text-white/40 tracking-widest\" data-kid=\"1-3-2-4-3-3-1-2-1-1\" data-name=\"durable delays state label\">\n                                        State: Suspended\n                                    </span>\n                                    <span class=\"text-[10px] font-mono text-[#cff75e]\" data-kid=\"1-3-2-4-3-3-1-2-1-2\" data-name=\"durable delays time remaining\">\n                                        14d 02h Remaining\n                                    </span>\n                                </div>\n                                <div class=\"w-full h-2 bg-white/5 rounded-full overflow-hidden\" data-kid=\"1-3-2-4-3-3-1-2-2\" data-name=\"durable delays progress bar background\">\n                                    <div class=\"h-full bg-[#cff75e] w-[40%] animate-pulse\" data-kid=\"1-3-2-4-3-3-1-2-2-1\" data-name=\"durable delays progress bar\">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- 04: AI Transforms -->\n                <div class=\"feature-block flex flex-col md:flex-row items-center gap-12\" data-kid=\"1-3-2-4-4\" data-name=\"ai transforms feature block\" id=\"block-04\">\n                    <div class=\"flex-1 order-3 md:order-1 md:pr-24 lg:pr-32\" data-kid=\"1-3-2-4-4-1\" data-name=\"ai transforms visualization\">\n                        <div class=\"bg-[#4a416b] border border-white/10 rounded-xl p-8 shadow-2xl relative\" data-kid=\"1-3-2-4-4-1-1\" data-name=\"ai transforms card\">\n                            <div class=\"flex items-center justify-between mb-6\" data-kid=\"1-3-2-4-4-1-1-1\" data-name=\"ai transforms header\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"1-3-2-4-4-1-1-1-1\" data-name=\"ai transforms model info\">\n                                    <i class=\"ti ti-robot text-[#cff75e]\" data-kid=\"1-3-2-4-4-1-1-1-1-1\" data-name=\"robot icon\">\n                                    </i>\n                                    <span class=\"text-[10px] font-mono uppercase text-white/60 tracking-widest\" data-kid=\"1-3-2-4-4-1-1-1-1-2\" data-name=\"ai transforms model label\">\n                                        GPT-4o / OpenRouter\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"space-y-3\" data-kid=\"1-3-2-4-4-1-1-2\" data-name=\"ai transforms skeleton bars\">\n                                <div class=\"h-2 w-full bg-white/10 rounded-full\" data-kid=\"1-3-2-4-4-1-1-2-1\" data-name=\"ai transforms skeleton bar 1\">\n                                </div>\n                                <div class=\"h-2 w-[80%] bg-white/10 rounded-full\" data-kid=\"1-3-2-4-4-1-1-2-2\" data-name=\"ai transforms skeleton bar 2\">\n                                </div>\n                                <div class=\"h-2 w-[60%] bg-[#cff75e]/30 rounded-full\" data-kid=\"1-3-2-4-4-1-1-2-3\" data-name=\"ai transforms skeleton bar 3\">\n                                </div>\n                            </div>\n                            <div class=\"mt-6 pt-6 border-t border-white/5 flex gap-4\" data-kid=\"1-3-2-4-4-1-1-3\" data-name=\"ai transforms output type container\">\n                                <div class=\"px-3 py-1 bg-white/5 rounded text-[9px] font-mono text-white/60\" data-kid=\"1-3-2-4-4-1-1-3-1\" data-name=\"ai transforms output type label\">\n                                    JSON_OUTPUT\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"node-ring w-14 h-14 md:w-20 md:h-20 rounded-full border-4 border-[#cff75e]/20 bg-[#201b2d] relative z-30 flex items-center justify-center order-2\" data-kid=\"1-3-2-4-4-2\" data-name=\"ai transforms node ring\">\n                        <i class=\"ti ti-robot text-2xl text-[#cff75e]/40 node-icon\" data-kid=\"1-3-2-4-4-2-1\" data-name=\"ai transforms icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-1 order-1 md:order-3 md:pl-24 lg:pl-32 text-left\" data-kid=\"1-3-2-4-4-3\" data-name=\"ai transforms feature description\">\n                        <div class=\"text-[#cff75e] font-mono text-xs mb-4 tracking-widest font-bold\" data-kid=\"1-3-2-4-4-3-1\" data-name=\"ai transforms phase label\">\n                            04 // INTELLIGENCE\n                        </div>\n                        <h2 class=\"font-['Space_Grotesk'] text-4xl md:text-5xl font-bold mb-6\" data-kid=\"1-3-2-4-4-3-2\" data-name=\"ai transforms title\">\n                            AI transforms\n                        </h2>\n                        <p class=\"text-white/50 text-lg leading-relaxed max-w-md\" data-kid=\"1-3-2-4-4-3-3\" data-name=\"ai transforms description text\">\n                            Seamlessly integrate LLMs via OpenRouter to transform unstructured data into validated objects.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Terminal & History Section -->\n        <section class=\"max-w-7xl mx-auto px-6 md:px-12 mt-32 md:mt-48\" data-kid=\"1-3-3\" data-name=\"terminal and history section\" id=\"terminal\">\n            <div class=\"terminal-panel bg-[#4a416b] border border-[#cff75e]/20 rounded-t-2xl overflow-hidden shadow-[0_-20px_100px_rgba(0,0,0,0.6)]\" data-kid=\"1-3-3-1\" data-name=\"terminal panel\">\n                <div class=\"bg-black/30 px-6 py-4 flex items-center justify-between border-b border-white/10\" data-kid=\"1-3-3-1-1\" data-name=\"terminal header\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-3-3-1-1-1\" data-name=\"terminal window controls\">\n                        <div class=\"flex gap-2\" data-kid=\"1-3-3-1-1-1-1\" data-name=\"terminal status lights\">\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-red-500/30\" data-kid=\"1-3-3-1-1-1-1-1\" data-name=\"terminal status light red\">\n                            </div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-yellow-500/30\" data-kid=\"1-3-3-1-1-1-1-2\" data-name=\"terminal status light yellow\">\n                            </div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-[#cff75e]/30\" data-kid=\"1-3-3-1-1-1-1-3\" data-name=\"terminal status light green\">\n                            </div>\n                        </div>\n                        <span class=\"text-[9px] font-mono text-white/30 uppercase tracking-[0.3em]\" data-kid=\"1-3-3-1-1-1-2\" data-name=\"terminal label\">\n                            System Output // Live Traces\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-3-3-1-1-2\" data-name=\"terminal meta info\">\n                        <span class=\"text-[9px] font-mono text-[#cff75e]/60\" data-kid=\"1-3-3-1-1-2-1\" data-name=\"terminal uptime status\">\n                            UPTIME: 142h 02m\n                        </span>\n                        <div class=\"w-px h-3 bg-white/10\" data-kid=\"1-3-3-1-1-2-2\" data-name=\"terminal separator\">\n                        </div>\n                        <span class=\"text-[9px] font-mono text-white/20\" data-kid=\"1-3-3-1-1-2-3\" data-name=\"terminal node version\">\n                            NODE_VERSION: v20.11.1\n                        </span>\n                    </div>\n                </div>\n                <div class=\"p-8 md:p-12 font-mono text-xs md:text-sm text-white/40 space-y-4 max-h-[500px] overflow-y-auto terminal-content\" data-kid=\"1-3-3-1-2\" data-name=\"terminal output content\">\n                    <div class=\"flex gap-6 border-l border-white/5 pl-4 hover:border-[#cff75e]/50 transition-colors\" data-kid=\"1-3-3-1-2-1\" data-name=\"log entry 1\">\n                        <span class=\"w-20 shrink-0\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"log timestamp\">\n                            14:22:01\n                        </span>\n                        <span class=\"text-[#cff75e] font-bold\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"log type\">\n                            INF\n                        </span>\n                        <span data-kid=\"1-3-3-1-2-1-3\" data-name=\"log message\">\n                            [INGRESS] Handled event\n                            <code class=\"text-blue-400\" data-kid=\"1-3-3-1-2-1-3-1\" data-name=\"log code snippet\">\n                                order.paid\n                            </code>\n                            from stripe_hook_01\n                        </span>\n                    </div>\n                    <div class=\"flex gap-6 border-l border-white/5 pl-4 hover:border-[#cff75e]/50 transition-colors\" data-kid=\"1-3-3-1-2-2\" data-name=\"log entry 2\">\n                        <span class=\"w-20 shrink-0\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"log timestamp\">\n                            14:22:01\n                        </span>\n                        <span class=\"text-[#cff75e] font-bold\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"log type\">\n                            SQL\n                        </span>\n                        <span data-kid=\"1-3-3-1-2-2-3\" data-name=\"log message\">\n                            [STATE] Created job_id\n                            <code class=\"text-white/60\" data-kid=\"1-3-3-1-2-2-3-1\" data-name=\"log job id\">\n                                job_88219\n                            </code>\n                            , persistence locked in PostgreSQL.\n                        </span>\n                    </div>\n                    <div class=\"flex gap-6 border-l border-white/5 pl-4 hover:border-[#cff75e]/50 transition-colors\" data-kid=\"1-3-3-1-2-3\" data-name=\"log entry 3\">\n                        <span class=\"w-20 shrink-0\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"log timestamp\">\n                            14:22:02\n                        </span>\n                        <span class=\"text-blue-400 font-bold\" data-kid=\"1-3-3-1-2-3-2\" data-name=\"log type\">\n                            QUE\n                        </span>\n                        <span data-kid=\"1-3-3-1-2-3-3\" data-name=\"log message\">\n                            [BULLMQ] Job pushed to\n                            <code class=\"text-white/60\" data-kid=\"1-3-3-1-2-3-3-1\" data-name=\"log queue name\">\n                                worker_pool_default\n                            </code>\n                        </span>\n                    </div>\n                    <div class=\"flex gap-6 border-l border-white/5 pl-4 hover:border-[#cff75e]/50 transition-colors\" data-kid=\"1-3-3-1-2-4\" data-name=\"log entry 4\">\n                        <span class=\"w-20 shrink-0\" data-kid=\"1-3-3-1-2-4-1\" data-name=\"log timestamp\">\n                            14:22:05\n                        </span>\n                        <span class=\"text-purple-400 font-bold\" data-kid=\"1-3-3-1-2-4-2\" data-name=\"log type\">\n                            LLM\n                        </span>\n                        <span data-kid=\"1-3-3-1-2-4-3\" data-name=\"log message\">\n                            [OPENROUTER] Analyzing text blob via gpt-4o-mini... (tokens: 412)\n                        </span>\n                    </div>\n                    <div class=\"flex gap-6 border-l border-white/5 pl-4 hover:border-[#cff75e]/50 transition-colors\" data-kid=\"1-3-3-1-2-5\" data-name=\"log entry 5\">\n                        <span class=\"w-20 shrink-0\" data-kid=\"1-3-3-1-2-5-1\" data-name=\"log timestamp\">\n                            14:22:06\n                        </span>\n                        <span class=\"text-[#cff75e] font-bold\" data-kid=\"1-3-3-1-2-5-2\" data-name=\"log type\">\n                            SUC\n                        </span>\n                        <span data-kid=\"1-3-3-1-2-5-3\" data-name=\"log message\">\n                            [AI] Structured output generated: { sentiment: 'positive', score: 0.98 }\n                        </span>\n                    </div>\n                    <div class=\"pt-8 mt-8 border-t border-white/5\" data-kid=\"1-3-3-1-2-6\" data-name=\"terminal progress status\">\n                        <div class=\"flex items-center justify-between mb-3\" data-kid=\"1-3-3-1-2-6-1\" data-name=\"terminal progress header\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-3-3-1-2-6-1-1\" data-name=\"terminal progress active indicator\">\n                                <div class=\"w-2 h-2 rounded-full bg-[#cff75e] animate-pulse\" data-kid=\"1-3-3-1-2-6-1-1-1\" data-name=\"terminal progress pulse dot\">\n                                </div>\n                                <span class=\"text-[10px] uppercase tracking-widest text-white/60\" data-kid=\"1-3-3-1-2-6-1-1-2\" data-name=\"terminal progress label\">\n                                    Active Pipeline Progress\n                                </span>\n                            </div>\n                            <span class=\"text-[#cff75e] font-mono font-bold\" data-kid=\"1-3-3-1-2-6-1-2\" data-name=\"terminal progress percentage\">\n                                85% COMPLETE\n                            </span>\n                        </div>\n                        <div class=\"w-full h-2 bg-white/5 rounded-full overflow-hidden\" data-kid=\"1-3-3-1-2-6-2\" data-name=\"terminal progress bar background\">\n                            <div class=\"h-full bg-[#cff75e] w-[85%] shadow-[0_0_20px_rgba(207,247,94,0.8)] relative\" data-kid=\"1-3-3-1-2-6-2-1\" data-name=\"terminal progress bar fill\">\n                                <div class=\"absolute inset-0 bg-gradient-to-r from-transparent to-white/30 animate-[shimmer_2s_infinite]\" data-kid=\"1-3-3-1-2-6-2-1-1\" data-name=\"terminal progress shimmer\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Final CTA -->\n        <section class=\"max-w-7xl mx-auto px-6 md:px-12 mt-32 md:mt-48 flex flex-col md:flex-row items-end justify-between\" data-kid=\"1-3-4\" data-name=\"final call-to-action section\">\n            <div class=\"mb-12 md:mb-0\" data-kid=\"1-3-4-1\" data-name=\"final call-to-action text block\">\n                <h2 class=\"font-['Space_Grotesk'] text-7xl md:text-[9rem] font-bold tracking-tighter leading-[0.85] mb-6\" data-kid=\"1-3-4-1-1\" data-name=\"final headline\">\n                    Start\n                    <br data-kid=\"1-3-4-1-1-1\" data-name=\"line break\"/>\n                    automating.\n                </h2>\n                <div class=\"text-white/30 font-mono text-sm uppercase tracking-[0.5em]\" data-kid=\"1-3-4-1-2\" data-name=\"final footer brand slogan\">\n                    Flowline // The engine for async logic.\n                </div>\n            </div>\n            <div class=\"flex flex-col items-end gap-8\" data-kid=\"1-3-4-2\" data-name=\"final call-to-action button container\">\n                <button class=\"bg-[#cff75e] text-[#201b2d] px-12 py-6 rounded-sm font-black text-2xl border-2 border-[#cff75e] hover:bg-transparent hover:text-[#cff75e] shadow-[0_0_60px_rgba(207,247,94,0.3)]\" data-kid=\"1-3-4-2-1\" data-name=\"final call-to-action button\">\n                    Get Started\n                </button>\n            </div>\n        </section>\n    </main>\n    <!-- Footer -->\n    <footer class=\"max-w-7xl mx-auto px-6 md:px-12 pb-24 border-t border-white/5 pt-16\" data-kid=\"1-4\" data-name=\"site footer\">\n        <div class=\"grid grid-cols-2 md:grid-cols-4 gap-16 mb-24\" data-kid=\"1-4-1\" data-name=\"footer navigation grid\">\n            <div data-kid=\"1-4-1-1\" data-name=\"footer column 1\">\n                <h5 class=\"text-xs font-black uppercase tracking-widest text-white mb-8\" data-kid=\"1-4-1-1-1\" data-name=\"footer column 1 title\">\n                    Engine\n                </h5>\n                <ul class=\"space-y-4 text-sm text-white/40\" data-kid=\"1-4-1-1-2\" data-name=\"footer column 1 links\">\n                    <li data-kid=\"1-4-1-1-2-1\" data-name=\"core library link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"core library link text\" href=\"#\">\n                            Core Library\n                        </a>\n                    </li>\n                    <li data-kid=\"1-4-1-1-2-2\" data-name=\"traces api link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-1-2-2-1\" data-name=\"traces api link text\" href=\"#\">\n                            Traces API\n                        </a>\n                    </li>\n                    <li data-kid=\"1-4-1-1-2-3\" data-name=\"bullmq config link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-1-2-3-1\" data-name=\"bullmq config link text\" href=\"#\">\n                            BullMQ Config\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"1-4-1-2\" data-name=\"footer column 2\">\n                <h5 class=\"text-xs font-black uppercase tracking-widest text-white mb-8\" data-kid=\"1-4-1-2-1\" data-name=\"footer column 2 title\">\n                    Ecosystem\n                </h5>\n                <ul class=\"space-y-4 text-sm text-white/40\" data-kid=\"1-4-1-2-2\" data-name=\"footer column 2 links\">\n                    <li data-kid=\"1-4-1-2-2-1\" data-name=\"postgresql sync link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"postgresql sync link text\" href=\"#\">\n                            PostgreSQL Sync\n                        </a>\n                    </li>\n                    <li data-kid=\"1-4-1-2-2-2\" data-name=\"openrouter ai link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"openrouter ai link text\" href=\"#\">\n                            OpenRouter AI\n                        </a>\n                    </li>\n                    <li data-kid=\"1-4-1-2-2-3\" data-name=\"webhooks link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-2-2-3-1\" data-name=\"webhooks link text\" href=\"#\">\n                            Webhooks\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"1-4-1-3\" data-name=\"footer column 3\">\n                <h5 class=\"text-xs font-black uppercase tracking-widest text-white mb-8\" data-kid=\"1-4-1-3-1\" data-name=\"footer column 3 title\">\n                    Developer\n                </h5>\n                <ul class=\"space-y-4 text-sm text-white/40\" data-kid=\"1-4-1-3-2\" data-name=\"footer column 3 links\">\n                    <li data-kid=\"1-4-1-3-2-1\" data-name=\"documentation link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-3-2-1-1\" data-name=\"documentation link text\" href=\"#\">\n                            Documentation\n                        </a>\n                    </li>\n                    <li data-kid=\"1-4-1-3-2-2\" data-name=\"changelog link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-3-2-2-1\" data-name=\"changelog link text\" href=\"#\">\n                            Changelog\n                        </a>\n                    </li>\n                    <li data-kid=\"1-4-1-3-2-3\" data-name=\"github link\">\n                        <a class=\"hover:text-[#cff75e] transition-colors\" data-kid=\"1-4-1-3-2-3-1\" data-name=\"github link text\" href=\"#\">\n                            Github\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"flex flex-col justify-between items-end text-right\" data-kid=\"1-4-1-4\" data-name=\"footer branding column\">\n                <div class=\"font-['Space_Grotesk'] text-2xl font-bold tracking-tighter\" data-kid=\"1-4-1-4-1\" data-name=\"footer brand name\">\n                    FLOW\n                    <span class=\"text-[#cff75e]\" data-kid=\"1-4-1-4-1-1\" data-name=\"footer brand name suffix\">\n                        LINE\n                    </span>\n                </div>\n                <div class=\"text-[10px] font-mono text-white/20 uppercase tracking-widest\" data-kid=\"1-4-1-4-2\" data-name=\"footer copyright notice\">\n                    © 2024 FLOWLINE ASYNC ENGINE.\n                    <br data-kid=\"1-4-1-4-2-1\" data-name=\"line break\"/>\n                    DURABLE EXECUTION BY DEFAULT.\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- GSAP Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script>\n        gsap.registerPlugin(ScrollTrigger);\n\n        document.addEventListener('DOMContentLoaded', () => {\n            // 1. Hero Blur-In\n            gsap.from('.hero-title', {\n                y: 50,\n                autoAlpha: 0,\n                filter: 'blur(15px)',\n                duration: 1.2,\n                ease: 'power4.out',\n                delay: 0.2\n            });\n\n            gsap.from('.hero-text-block p, .hero-text-block button', {\n                y: 30,\n                autoAlpha: 0,\n                duration: 1,\n                stagger: 0.1,\n                ease: 'power3.out',\n                delay: 0.5\n            });\n\n            gsap.from('.trigger-node', {\n                scale: 0.8,\n                autoAlpha: 0,\n                duration: 1.2,\n                ease: 'elastic.out(1, 0.75)',\n                delay: 0.6\n            });\n\n            // Card Entrance Animations\n            featureBlocks.forEach((block) => {\n                const content = block.querySelectorAll('.flex-1');\n                gsap.from(content, {\n                    y: 40,\n                    autoAlpha: 0,\n                    duration: 0.8,\n                    stagger: 0.2,\n                    scrollTrigger: {\n                        trigger: block,\n                        start: 'top 85%'\n                    }\n                });\n            });\n\n            // 2. Pipeline Rail Drawing\n            gsap.to('#pipeline-rail-draw', {\n                scaleY: 1,\n                ease: 'none',\n                scrollTrigger: {\n                    trigger: '.relative.max-w-7xl',\n                    start: 'top top',\n                    end: 'bottom bottom',\n                    scrub: 0.2\n                }\n            });\n\n            // 3. Node Pulse & Activation\n            const featureBlocks = document.querySelectorAll('.feature-block');\n            featureBlocks.forEach((block) => {\n                const ring = block.querySelector('.node-ring');\n                const icon = block.querySelector('.node-icon');\n                \n                if (ring) {\n                    gsap.to(ring, {\n                        borderColor: '#cff75e',\n                        backgroundColor: '#4a416b',\n                        boxShadow: '0 0 30px rgba(207,247,94,0.4)',\n                        scrollTrigger: {\n                            trigger: block,\n                            start: 'top 60%',\n                            end: 'bottom 40%',\n                            toggleActions: 'play reverse play reverse'\n                        }\n                    });\n\n                    if (icon) {\n                        gsap.to(icon, {\n                            color: '#cff75e',\n                            scale: 1.2,\n                            scrollTrigger: {\n                                trigger: block,\n                                start: 'top 60%',\n                                end: 'bottom 40%',\n                                toggleActions: 'play reverse play reverse'\n                            }\n                        });\n                    }\n                }\n            });\n\n            // 4. Terminal Appearance\n            gsap.from('.terminal-panel', {\n                y: 200,\n                autoAlpha: 0,\n                duration: 1.2,\n                ease: 'power3.out',\n                scrollTrigger: {\n                    trigger: '#terminal',\n                    start: 'top 95%',\n                    end: 'bottom bottom',\n                    toggleActions: 'play none none reverse'\n                }\n            });\n\n            // 5. Rotation Scrub\n            gsap.to('#motion-target-scrub-rotation', {\n                rotate: 360,\n                scrollTrigger: {\n                    trigger: '.relative.max-w-7xl',\n                    start: 'top top',\n                    end: 'bottom bottom',\n                    scrub: 0.5\n                }\n            });\n\n            // 6. Branch Line Animation in block-02\n            gsap.from('.branch-line-anim', {\n                scaleX: 0,\n                duration: 1.5,\n                ease: 'power2.inOut',\n                scrollTrigger: {\n                    trigger: '#block-02',\n                    start: 'top 60%'\n                }\n            });\n        });\n    </script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;500;600;700;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .terminal-content::-webkit-scrollbar {\n            width: 5px;\n        }\n        .terminal-content::-webkit-scrollbar-track {\n            background: transparent;\n        }\n        .terminal-content::-webkit-scrollbar-thumb {\n            background: rgba(207, 247, 94, 0.1);\n            border-radius: 10px;\n        }\n        .terminal-content::-webkit-scrollbar-thumb:hover {\n            background: rgba(207, 247, 94, 0.3);\n        }\n\n        /* Prevent potential GSAP vs Tailwind conflicts */\n        .hero-title, .hero-text-block p, .hero-text-block button, .trigger-node, .node-ring, .node-icon, .terminal-panel, .branch-line-anim, .feature-block > div {\n            transition: none !important;\n        }\n\n        /* Specific tabler icon fixes */\n        .ti {\n            display: inline-block;\n            line-height: 1;\n        }\n\n        @keyframes shimmer {\n            0% { transform: translateX(-100%); }\n            100% { transform: translateX(100%); }\n        }\n    </style>\n</div>\n",
      "comments": [],
      "created": "2026-08-06T05:47:10.569557+00:00",
      "modified": "2026-08-06T05:47:10.569557+00:00",
      "id": "var_ebea94cac314"
    },
    "var_4a574c59d34f": {
      "type": "variant",
      "label": "Flowline — Architecture First",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;700;900&family=Overpass:wght@300;400;600&family=JetBrains+Mono&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --midnight: #14111c;\n        --slate: #3b3554;\n        --mint: #a3f774;\n        --sage: #83d65c;\n    }\n\n    .graph-paper {\n        background-color: var(--midnight);\n        background-image: \n            linear-gradient(rgba(59, 53, 84, 0.15) 1px, transparent 1px),\n            linear-gradient(90deg, rgba(59, 53, 84, 0.15) 1px, transparent 1px);\n        background-size: 20px 20px;\n    }\n\n    .font-heading { font-family: 'Schibsted Grotesk', sans-serif; }\n    .font-mono { font-family: 'JetBrains Mono', monospace; }\n    .font-sans { font-family: 'Overpass', sans-serif; }\n\n    .hairline { border: 1px solid var(--slate); }\n    .hairline-b { border-bottom: 1px solid var(--slate); }\n    .hairline-r { border-right: 1px solid var(--slate); }\n    .hairline-l { border-left: 1px solid var(--slate); }\n    .hairline-t { border-top: 1px solid var(--slate); }\n\n    .btn-primary {\n        background-color: var(--mint);\n        color: var(--midnight);\n        padding: 0.75rem 1.5rem;\n        font-weight: 700;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        font-size: 0.875rem;\n        border: 1px solid var(--mint);\n        cursor: pointer;\n    }\n\n    .mask-container {\n        clip-path: inset(0 100% 0 0);\n    }\n\n    .node-pulse {\n        fill: var(--midnight);\n        stroke: var(--slate);\n    }\n    .node-pulse.active-node {\n        stroke: var(--mint);\n        fill: rgba(163, 247, 116, 0.1);\n    }\n\n    .tech-divider {\n        height: 1px;\n        background: linear-gradient(90deg, var(--slate) 0%, transparent 100%);\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n        height: 4px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: var(--midnight);\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: var(--slate);\n    }\n</style>\n<!-- Lenis CSS -->\n<link data-kid=\"1\" data-name=\"Lenis smooth scroll stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"graph-paper min-h-screen text-white font-sans selection:bg-mint selection:text-midnight\" data-kid=\"2\" data-name=\"page background container\">\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 left-0 w-full z-50 hairline-b bg-[#14111c]/80 backdrop-blur-md\" data-kid=\"2-1\" data-name=\"main navigation bar\">\n        <div class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"2-1-1\" data-name=\"navigation inner wrapper\">\n            <div class=\"flex items-center gap-8\" data-kid=\"2-1-1-1\" data-name=\"brand and link group\">\n                <a class=\"font-heading text-xl font-black tracking-tighter text-white\" data-kid=\"2-1-1-1-1\" data-name=\"logo brand link\" href=\"#\">\n                    FLOWLINE\n                    <span class=\"text-mint\" data-kid=\"2-1-1-1-1-1\" data-name=\"logo brand period\">\n                        .\n                    </span>\n                </a>\n                <div class=\"hidden md:flex items-center gap-6 text-[10px] font-mono uppercase tracking-[0.2em] text-slate-400\" data-kid=\"2-1-1-1-2\" data-name=\"nav menu link group\">\n                    <a class=\"hover:text-mint transition-colors\" data-kid=\"2-1-1-1-2-1\" data-name=\"nav link engine\" href=\"#engine\">\n                        Engine\n                    </a>\n                    <a class=\"hover:text-mint transition-colors\" data-kid=\"2-1-1-1-2-2\" data-name=\"nav link traces\" href=\"#traces\">\n                        Traces\n                    </a>\n                    <a class=\"hover:text-mint transition-colors\" data-kid=\"2-1-1-1-2-3\" data-name=\"nav link docs\" href=\"#\">\n                        Docs\n                    </a>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"2-1-1-2\" data-name=\"utility link and cta group\">\n                <div class=\"hidden lg:block text-[9px] font-mono text-slate-500 uppercase px-3 py-1 hairline border-slate-700\" data-kid=\"2-1-1-2-1\" data-name=\"infrastructure specs label\">\n                    BUILDING BLOCKS / WEBHOOKS · BULLMQ · POSTGRES\n                </div>\n                <button class=\"bg-mint text-midnight px-4 py-1.5 text-[10px] font-bold uppercase tracking-widest cursor-pointer hover:bg-white transition-colors\" data-kid=\"2-1-1-2-2\" data-name=\"primary navigation get started button\">\n                    Get Started\n                </button>\n            </div>\n        </div>\n    </nav>\n    <!-- Hero Section -->\n    <section class=\"min-h-screen pt-32 pb-20 px-6 flex flex-col justify-center overflow-x-clip\" data-kid=\"2-2\" data-name=\"hero section\">\n        <div class=\"max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\" data-kid=\"2-2-1\" data-name=\"hero section inner layout\">\n            <!-- Hero Content -->\n            <div class=\"lg:col-span-5 space-y-8 z-10 hero-text\" data-kid=\"2-2-1-1\" data-name=\"hero content column\">\n                <div class=\"space-y-6\" data-kid=\"2-2-1-1-1\" data-name=\"hero headline group\">\n                    <div class=\"inline-block px-3 py-1 hairline text-[10px] font-mono text-mint uppercase tracking-widest\" data-kid=\"2-2-1-1-1-1\" data-name=\"hero badge\">\n                        Durable Execution Engine\n                    </div>\n                    <h1 class=\"font-heading text-6xl md:text-[5.5rem] font-black text-white leading-[0.85] tracking-tighter\" data-kid=\"2-2-1-1-1-2\" data-name=\"hero headline\">\n                        Build reliable\n                        <br data-kid=\"2-2-1-1-1-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-mint\" data-kid=\"2-2-1-1-1-2-2\" data-name=\"hero headline primary focus\">\n                            pipelines.\n                        </span>\n                    </h1>\n                    <p class=\"text-slate-400 text-lg md:text-xl max-w-md leading-relaxed\" data-kid=\"2-2-1-1-1-3\" data-name=\"hero subheadline\">\n                        Asynchronous orchestration and durable execution for critical infrastructure. \n                        Stop handling worker crashes—automate them with BullMQ and Postgres.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-8\" data-kid=\"2-2-1-1-2\" data-name=\"hero cta group\">\n                    <button class=\"btn-primary cursor-pointer hover:shadow-[0_0_20px_rgba(163,247,116,0.3)]\" data-kid=\"2-2-1-1-2-1\" data-name=\"hero primary get started button\">\n                        Get Started\n                    </button>\n                    <button class=\"text-slate-400 font-mono text-[10px] uppercase tracking-[0.2em] flex items-center gap-2 hover:text-mint transition-colors cursor-pointer\" data-kid=\"2-2-1-1-2-2\" data-name=\"hero inspect architecture button\" id=\"scroll-engine-btn\">\n                        Inspect Engine Architecture\n                        <i class=\"ti ti-arrow-narrow-right text-sm\" data-kid=\"2-2-1-1-2-2-1\" data-name=\"arrow icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Hero Graph Representation -->\n            <div class=\"lg:col-span-7 relative hero-visual\" data-kid=\"2-2-1-2\" data-name=\"hero visual graph column\">\n                <div class=\"hairline bg-[#14111c]/60 p-2 md:p-4 relative overflow-hidden\" data-kid=\"2-2-1-2-1\" data-name=\"graph container wrapper\">\n                    <div class=\"absolute top-0 right-0 px-3 py-1 text-[9px] font-mono text-slate-500 hairline-l hairline-b uppercase z-30 bg-[#14111c]\" data-kid=\"2-2-1-2-1-1\" data-name=\"graph version label\">\n                        EXECUTION GRAPH / v0.9.4\n                    </div>\n                    <svg class=\"w-full h-auto drop-shadow-[0_0_50px_rgba(163,247,116,0.03)] scale-105\" data-kid=\"2-2-1-2-1-2\" data-name=\"execution graph svg\" id=\"hero-svg\" viewbox=\"50 120 700 320\">\n                        <!-- Connectors -->\n                        <g class=\"connectors\" fill=\"none\" stroke-width=\"2\">\n                            <path class=\"base-path\" d=\"M 50 250 L 150 250\" stroke=\"var(--slate)\">\n                            </path>\n                            <path class=\"base-path\" d=\"M 150 250 L 250 150 L 350 150\" stroke=\"var(--slate)\">\n                            </path>\n                            <path class=\"base-path\" d=\"M 250 150 L 250 350 L 350 350\" stroke=\"var(--slate)\">\n                            </path>\n                            <path class=\"base-path\" d=\"M 350 150 L 450 250 L 550 250\" stroke=\"var(--slate)\">\n                            </path>\n                            <path class=\"base-path\" d=\"M 350 350 L 450 250\" stroke=\"var(--slate)\">\n                            </path>\n                            <path class=\"base-path\" d=\"M 550 250 L 750 250\" stroke=\"var(--slate)\">\n                            </path>\n                            <path d=\"M 50 250 L 150 250 L 250 150 L 350 150 L 450 250 L 550 250 L 750 250\" id=\"flow-path-main\" stroke=\"var(--mint)\" stroke-dasharray=\"20, 1000\">\n                            </path>\n                            <path d=\"M 250 150 L 250 350 L 350 350 L 450 250\" id=\"flow-path-sub\" stroke=\"var(--mint)\" stroke-dasharray=\"20, 1000\">\n                            </path>\n                        </g>\n                        <!-- Nodes -->\n                        <g class=\"node-group\" data-node=\"trigger\">\n                            <rect class=\"node-pulse\" height=\"40\" width=\"40\" x=\"30\" y=\"230\">\n                            </rect>\n                            <text class=\"font-mono text-[9px] fill-slate-500 uppercase tracking-tighter\" text-anchor=\"middle\" x=\"50\" y=\"285\">\n                                Trigger\n                            </text>\n                            <circle cx=\"50\" cy=\"250\" fill=\"var(--mint)\" r=\"4\">\n                            </circle>\n                        </g>\n                        <g class=\"node-group\" data-node=\"branch\">\n                            <rect class=\"node-pulse\" height=\"40\" width=\"40\" x=\"130\" y=\"230\">\n                            </rect>\n                            <text class=\"font-mono text-[9px] fill-slate-500 uppercase tracking-tighter\" text-anchor=\"middle\" x=\"150\" y=\"285\">\n                                Branch\n                            </text>\n                            <path d=\"M 145 250 L 155 250 M 150 245 L 150 255\" stroke=\"var(--slate)\" stroke-width=\"2\">\n                            </path>\n                        </g>\n                        <g class=\"node-group\" data-node=\"delay\">\n                            <rect class=\"node-pulse\" height=\"40\" width=\"40\" x=\"330\" y=\"130\">\n                            </rect>\n                            <text class=\"font-mono text-[9px] fill-slate-500 uppercase tracking-tighter\" text-anchor=\"middle\" x=\"350\" y=\"185\">\n                                Delay\n                            </text>\n                            <circle cx=\"350\" cy=\"150\" fill=\"none\" r=\"7\" stroke=\"var(--slate)\">\n                            </circle>\n                            <path d=\"M 350 146 L 350 150 L 354 150\" stroke=\"var(--slate)\" stroke-width=\"1.5\">\n                            </path>\n                        </g>\n                        <g class=\"node-group\" data-node=\"db\">\n                            <rect class=\"node-pulse\" height=\"40\" width=\"40\" x=\"330\" y=\"330\">\n                            </rect>\n                            <text class=\"font-mono text-[9px] fill-slate-500 uppercase tracking-tighter\" text-anchor=\"middle\" x=\"350\" y=\"385\">\n                                State\n                            </text>\n                            <path d=\"M 342 345 Q 350 342 358 345 L 358 355 Q 350 358 342 355 Z\" fill=\"none\" stroke=\"var(--slate)\" stroke-width=\"1.5\">\n                            </path>\n                        </g>\n                        <g class=\"node-group\" data-node=\"ai\">\n                            <rect class=\"node-pulse\" height=\"40\" width=\"40\" x=\"530\" y=\"230\">\n                            </rect>\n                            <text class=\"font-mono text-[9px] fill-slate-500 uppercase tracking-tighter\" text-anchor=\"middle\" x=\"550\" y=\"285\">\n                                AI\n                            </text>\n                            <path d=\"M 545 250 L 555 250 M 550 245 L 550 255\" stroke=\"var(--mint)\" stroke-width=\"2\" transform=\"rotate(45, 550, 250)\">\n                            </path>\n                        </g>\n                        <g class=\"callouts\">\n                            <line stroke=\"var(--slate)\" stroke-dasharray=\"2,2\" x1=\"50\" x2=\"30\" y1=\"230\" y2=\"150\">\n                            </line>\n                            <circle class=\"cursor-help\" cx=\"30\" cy=\"150\" fill=\"var(--mint)\" r=\"10\">\n                            </circle>\n                            <text fill=\"var(--midnight)\" font-size=\"10\" font-weight=\"900\" text-anchor=\"middle\" x=\"30\" y=\"154\">\n                                1\n                            </text>\n                            <line stroke=\"var(--slate)\" stroke-dasharray=\"2,2\" x1=\"350\" x2=\"380\" y1=\"370\" y2=\"440\">\n                            </line>\n                            <circle class=\"cursor-help\" cx=\"380\" cy=\"440\" fill=\"var(--mint)\" r=\"10\">\n                            </circle>\n                            <text fill=\"var(--midnight)\" font-size=\"10\" font-weight=\"900\" text-anchor=\"middle\" x=\"380\" y=\"444\">\n                                2\n                            </text>\n                        </g>\n                    </svg>\n                    <div class=\"absolute top-[80px] left-[10px] w-44 p-3 bg-[#14111c]/95 hairline border-mint text-[9px] font-mono group hidden md:block z-20\" data-kid=\"2-2-1-2-1-3\" data-name=\"callout panel one\">\n                        <span class=\"text-mint block mb-1 font-bold uppercase tracking-widest\" data-kid=\"2-2-1-2-1-3-1\" data-name=\"callout panel one title\">\n                            01 / WEBHOOK INGESTION\n                        </span>\n                        Persists raw payload to Postgres staging buffer immediately. Zero-loss ingestion logic.\n                    </div>\n                    <div class=\"absolute bottom-[20px] left-[40%] w-44 p-3 bg-[#14111c]/95 hairline border-mint text-[9px] font-mono group hidden md:block z-20\" data-kid=\"2-2-1-2-1-4\" data-name=\"callout panel two\">\n                        <span class=\"text-mint block mb-1 font-bold uppercase tracking-widest\" data-kid=\"2-2-1-2-1-4-1\" data-name=\"callout panel two title\">\n                            02 / DURABLE STATE\n                        </span>\n                        BullMQ workers resume from the exact last successful step after any worker crash.\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Bento Grid Engine Section -->\n    <section class=\"py-24 px-6 hairline-t\" data-kid=\"2-3\" data-name=\"engine section\" id=\"engine\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"2-3-1\" data-name=\"engine section inner wrapper\">\n            <div class=\"flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8\" data-kid=\"2-3-1-1\" data-name=\"engine section header\">\n                <div data-kid=\"2-3-1-1-1\" data-name=\"engine header group\">\n                    <span class=\"font-mono text-mint text-xs uppercase tracking-widest mb-3 block\" data-kid=\"2-3-1-1-1-1\" data-name=\"engine section label\">\n                        Architecture / Engine\n                    </span>\n                    <h2 class=\"font-heading text-4xl md:text-5xl font-black text-white uppercase tracking-tighter\" data-kid=\"2-3-1-1-1-2\" data-name=\"engine section title\">\n                        Inner Workings\n                    </h2>\n                </div>\n                <p class=\"text-slate-500 max-w-sm font-mono text-[10px] uppercase leading-relaxed tracking-widest\" data-kid=\"2-3-1-1-2\" data-name=\"engine section description\">\n                    Built for developers who demand high durability and low maintenance. No abstract magic, just robust primitives.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-px bg-slate-800 border border-slate-800\" data-kid=\"2-3-1-2\" data-name=\"bento grid layout\">\n                <div class=\"md:col-span-2 md:row-span-2 bg-[#14111c] p-10 flex flex-col group relative overflow-hidden bento-cell\" data-kid=\"2-3-1-2-1\" data-name=\"bento cell resilience\">\n                    <div class=\"flex justify-between items-start mb-12\" data-kid=\"2-3-1-2-1-1\" data-name=\"bento resilience header\">\n                        <div data-kid=\"2-3-1-2-1-1-1\" data-name=\"bento resilience title group\">\n                            <h3 class=\"text-mint font-mono text-[10px] uppercase tracking-widest mb-2\" data-kid=\"2-3-1-2-1-1-1-1\" data-name=\"bento resilience label\">\n                                01 / Resilience\n                            </h3>\n                            <p class=\"text-3xl font-heading font-bold\" data-kid=\"2-3-1-2-1-1-1-2\" data-name=\"bento resilience title\">\n                                Idempotent Retries\n                            </p>\n                        </div>\n                        <i class=\"ti ti-refresh text-3xl text-slate-700 group-hover:text-mint transition-colors\" data-kid=\"2-3-1-2-1-1-2\" data-name=\"refresh icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex-grow flex items-end gap-3 px-2 min-h-[150px]\" data-kid=\"2-3-1-2-1-2\" data-name=\"bento resilience chart wrapper\">\n                        <div class=\"w-full bg-slate-900 hairline border-slate-800 relative h-[15%] group-hover:h-[20%] transition-all duration-500\" data-kid=\"2-3-1-2-1-2-1\" data-name=\"chart bar 1\">\n                            <div class=\"absolute bottom-0 w-full bg-mint/10 h-1/2\" data-kid=\"2-3-1-2-1-2-1-1\" data-name=\"chart bar 1 fill\">\n                            </div>\n                        </div>\n                        <div class=\"w-full bg-slate-900 hairline border-slate-800 relative h-[30%] group-hover:h-[40%] transition-all duration-500\" data-kid=\"2-3-1-2-1-2-2\" data-name=\"chart bar 2\">\n                            <div class=\"absolute bottom-0 w-full bg-mint/10 h-1/2\" data-kid=\"2-3-1-2-1-2-2-1\" data-name=\"chart bar 2 fill\">\n                            </div>\n                        </div>\n                        <div class=\"w-full bg-slate-900 hairline border-slate-800 relative h-[55%] group-hover:h-[70%] transition-all duration-500\" data-kid=\"2-3-1-2-1-2-3\" data-name=\"chart bar 3\">\n                            <div class=\"absolute bottom-0 w-full bg-mint/10 h-1/2\" data-kid=\"2-3-1-2-1-2-3-1\" data-name=\"chart bar 3 fill\">\n                            </div>\n                        </div>\n                        <div class=\"w-full bg-slate-900 hairline border-slate-800 relative h-[85%] group-hover:h-[100%] transition-all duration-500\" data-kid=\"2-3-1-2-1-2-4\" data-name=\"chart bar 4\">\n                            <div class=\"absolute bottom-0 w-full bg-mint/10 h-1/2\" data-kid=\"2-3-1-2-1-2-4-1\" data-name=\"chart bar 4 fill\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-12 flex justify-between font-mono text-[9px] text-slate-500 uppercase tracking-widest\" data-kid=\"2-3-1-2-1-3\" data-name=\"bento resilience footer\">\n                        <span data-kid=\"2-3-1-2-1-3-1\" data-name=\"bento resilience backoff label\">\n                            EXPONENTIAL BACKOFF / 2^n\n                        </span>\n                        <span data-kid=\"2-3-1-2-1-3-2\" data-name=\"bento resilience attempts label\">\n                            MAX ATTEMPTS: 12\n                        </span>\n                    </div>\n                </div>\n                <div class=\"md:col-span-2 bg-[#14111c] p-8 flex flex-col group bento-cell\" data-kid=\"2-3-1-2-2\" data-name=\"bento cell atomic ingestion\">\n                    <div class=\"flex items-center gap-4 mb-6\" data-kid=\"2-3-1-2-2-1\" data-name=\"bento ingestion header group\">\n                        <div class=\"w-12 h-12 hairline border-slate-700 flex items-center justify-center text-mint\" data-kid=\"2-3-1-2-2-1-1\" data-name=\"bento ingestion icon wrapper\">\n                            <i class=\"ti ti-webhook text-2xl\" data-kid=\"2-3-1-2-2-1-1-1\" data-name=\"webhook icon\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-heading text-2xl font-bold\" data-kid=\"2-3-1-2-2-1-2\" data-name=\"bento ingestion title\">\n                            Atomic Ingestion\n                        </h3>\n                    </div>\n                    <p class=\"text-slate-400 text-sm leading-relaxed mb-8\" data-kid=\"2-3-1-2-2-2\" data-name=\"bento ingestion description\">\n                        Every incoming trigger is validated and persisted in a single transaction. No data ever drops, even during sudden traffic spikes.\n                    </p>\n                    <div class=\"mt-auto flex flex-wrap gap-2\" data-kid=\"2-3-1-2-2-3\" data-name=\"bento ingestion tags\">\n                        <span class=\"text-[9px] font-mono bg-slate-900 text-slate-400 px-3 py-1 hairline uppercase\" data-kid=\"2-3-1-2-2-3-1\" data-name=\"bento ingestion tag rest api\">\n                            Rest API\n                        </span>\n                        <span class=\"text-[9px] font-mono bg-slate-900 text-slate-400 px-3 py-1 hairline uppercase\" data-kid=\"2-3-1-2-2-3-2\" data-name=\"bento ingestion tag cron\">\n                            Cron Triggers\n                        </span>\n                        <span class=\"text-[9px] font-mono bg-slate-900 text-slate-400 px-3 py-1 hairline uppercase\" data-kid=\"2-3-1-2-2-3-3\" data-name=\"bento ingestion tag polling\">\n                            Polling\n                        </span>\n                    </div>\n                </div>\n                <div class=\"bg-[#14111c] p-8 flex flex-col group bento-cell\" data-kid=\"2-3-1-2-3\" data-name=\"bento cell postgres\">\n                    <i class=\"ti ti-database text-3xl text-slate-700 group-hover:text-mint mb-4 block transition-colors\" data-kid=\"2-3-1-2-3-1\" data-name=\"database icon\">\n                    </i>\n                    <h3 class=\"font-heading font-bold text-lg mb-2\" data-kid=\"2-3-1-2-3-2\" data-name=\"bento postgres title\">\n                        Postgres State\n                    </h3>\n                    <p class=\"text-xs text-slate-500 leading-relaxed uppercase tracking-tighter\" data-kid=\"2-3-1-2-3-3\" data-name=\"bento postgres description\">\n                        Checkpoint execution every 10ms. Durable JSON storage for every worker step.\n                    </p>\n                </div>\n                <div class=\"bg-mint text-midnight p-8 flex flex-col group bento-cell\" data-kid=\"2-3-1-2-4\" data-name=\"bento cell bullmq\">\n                    <i class=\"ti ti-server text-3xl mb-4 block\" data-kid=\"2-3-1-2-4-1\" data-name=\"server icon\">\n                    </i>\n                    <h3 class=\"font-heading font-bold text-lg mb-2\" data-kid=\"2-3-1-2-4-2\" data-name=\"bento bullmq title\">\n                        BullMQ Workers\n                    </h3>\n                    <p class=\"text-xs font-bold opacity-75 uppercase tracking-tighter\" data-kid=\"2-3-1-2-4-3\" data-name=\"bento bullmq description\">\n                        Distributed task processing with built-in concurrency and rate limiting.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Comparison Section -->\n    <section class=\"min-h-screen py-24 hairline-t relative overflow-hidden bg-[#14111c]\" data-kid=\"2-4\" data-name=\"data transforms section\">\n        <div class=\"max-w-7xl mx-auto px-6 h-full flex flex-col\" data-kid=\"2-4-1\" data-name=\"transforms section inner wrapper\">\n            <div class=\"mb-16\" data-kid=\"2-4-1-1\" data-name=\"transforms header group\">\n                <span class=\"font-mono text-mint text-xs uppercase tracking-widest mb-3 block\" data-kid=\"2-4-1-1-1\" data-name=\"transforms label\">\n                    AI Integration / OpenRouter\n                </span>\n                <h2 class=\"font-heading text-4xl md:text-5xl font-black text-white uppercase tracking-tighter\" data-kid=\"2-4-1-1-2\" data-name=\"transforms title\">\n                    Zero-shot Data Transforms\n                </h2>\n            </div>\n            <div class=\"flex-grow grid grid-cols-1 md:grid-cols-2 hairline overflow-hidden relative\" data-kid=\"2-4-1-2\" data-name=\"transforms comparison grid\">\n                <div class=\"p-8 md:p-12 hairline-r bg-[#14111c] z-0 min-h-[400px]\" data-kid=\"2-4-1-2-1\" data-name=\"transforms input column\">\n                    <div class=\"flex justify-between items-center mb-8\" data-kid=\"2-4-1-2-1-1\" data-name=\"input column header\">\n                        <span class=\"text-[10px] font-mono text-slate-500 uppercase tracking-widest\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"input label\">\n                            Input / Webhook Payload\n                        </span>\n                        <div class=\"flex gap-1.5\" data-kid=\"2-4-1-2-1-1-2\" data-name=\"input status dots\">\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-slate-800\" data-kid=\"2-4-1-2-1-1-2-1\" data-name=\"dot\">\n                            </div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-slate-800\" data-kid=\"2-4-1-2-1-1-2-2\" data-name=\"dot\">\n                            </div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-slate-800\" data-kid=\"2-4-1-2-1-1-2-3\" data-name=\"dot\">\n                            </div>\n                        </div>\n                    </div>\n                    <pre class=\"text-slate-500 text-[11px] font-mono leading-[2.2] overflow-x-auto\" data-kid=\"2-4-1-2-1-2\" data-name=\"input payload code\">\n{\n  \"event\": \"customer.feedback\",\n  \"data\": {\n    \"user_id\": \"usr_v2_99\",\n    \"content\": \"I love the engine, but the \n    delays are killing me! Fix it \n    now or I am switching.\",\n    \"rating\": 2,\n    \"platform\": \"mobile_ios\",\n    \"context\": {\n      \"session_id\": \"sess_882\",\n      \"retry_count\": 0\n    }\n  },\n  \"timestamp\": \"2024-05-20T12:00:00Z\"\n}\n                    </pre>\n                </div>\n                <div class=\"p-0 bg-slate-900/10 relative overflow-hidden min-h-[400px]\" data-kid=\"2-4-1-2-2\" data-name=\"transforms output column\">\n                    <div class=\"absolute inset-0 p-8 md:p-12 z-10 mask-container bg-[#14111c]\" data-kid=\"2-4-1-2-2-1\" data-name=\"output column mask container\">\n                        <div class=\"flex justify-between items-center mb-8\" data-kid=\"2-4-1-2-2-1-1\" data-name=\"output column header\">\n                            <span class=\"text-[10px] font-mono text-mint uppercase tracking-widest font-bold\" data-kid=\"2-4-1-2-2-1-1-1\" data-name=\"output label\">\n                                Output / AI Structured\n                            </span>\n                            <span class=\"text-[9px] font-mono text-mint animate-pulse uppercase\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-1-1-2\" data-name=\"output sync status\" data-reason=\"class toggled by scroll interaction\">\n                                Sync Complete\n                            </span>\n                        </div>\n                        <pre class=\"text-mint text-[11px] font-mono leading-[2.2]\" data-kid=\"2-4-1-2-2-1-2\" data-name=\"output payload code\">\n{\n  \"sentiment\": \"critical_negative\",\n  \"urgency\": \"immediate\",\n  \"action_item\": \"trigger_support_escalation\",\n  \"labels\": [\"churn_risk\", \"performance\"],\n  \"meta\": {\n    \"model\": \"gpt-4o\",\n    \"latency\": \"442ms\",\n    \"cost\": \"$0.0012\",\n    \"tokens\": 154,\n    \"trace_id\": \"tr_ai_991\"\n  }\n}\n                        </pre>\n                    </div>\n                    <div class=\"opacity-30 pointer-events-none p-8 md:p-12\" data-kid=\"2-4-1-2-2-2\" data-name=\"output column logs background\">\n                        <pre class=\"text-slate-500 text-[10px] font-mono leading-[2.5] uppercase tracking-widest\" data-kid=\"2-4-1-2-2-2-1\" data-name=\"output console logs\">\n> INITIALIZING OPENROUTER HANDSHAKE\n> AUTHENTICATING WORKER_01\n> INGESTING RAW PAYLOAD\n> BUFFERING TO POSTGRES STATE\n> COMPUTING SEMANTIC MAPPING\n> GENERATING STRUCTURED OUTPUT...\n                         </pre>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Execution Trace Table -->\n    <section class=\"py-24 px-6 hairline-t bg-[