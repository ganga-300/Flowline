<td class=\"py-6\" data-kid=\"2-5-1-2-1-2-2-4\" data-name=\"status cell\">\n                                <span class=\"flex items-center gap-3 text-sage animate-pulse font-bold uppercase text-[10px] tracking-widest\" data-kid=\"2-5-1-2-1-2-2-4-1\" data-name=\"status wrapper\">\n                                    <span class=\"w-1.5 h-1.5 bg-sage\" data-kid=\"2-5-1-2-1-2-2-4-1-1\" data-name=\"status indicator\">\n                                    </span>\n                                    Pending\n                                </span>\n                            </td>\n                            <td class=\"py-6 text-right text-slate-400 font-bold\" data-kid=\"2-5-1-2-1-2-2-5\" data-name=\"steps cell\">\n                                04 / 12\n                            </td>\n                        </tr>\n                        <tr class=\"hairline-b border-slate-900 group hover:bg-slate-900/40 reveal-row cursor-pointer transition-colors\" data-kid=\"2-5-1-2-1-2-3\" data-name=\"table data row 3\">\n                            <td class=\"py-6 text-white font-bold\" data-kid=\"2-5-1-2-1-2-3-1\" data-name=\"id cell\">\n                                #fl_5594_c\n                            </td>\n                            <td class=\"py-6 text-slate-500\" data-kid=\"2-5-1-2-1-2-3-2\" data-name=\"trigger cell\">\n                                webhook.in\n                            </td>\n                            <td class=\"py-6 text-slate-500\" data-kid=\"2-5-1-2-1-2-3-3\" data-name=\"runtime cell\">\n                                0.82s\n                            </td>\n                            <td class=\"py-6\" data-kid=\"2-5-1-2-1-2-3-4\" data-name=\"status cell\">\n                                <span class=\"flex items-center gap-3 text-red-500 font-bold uppercase text-[10px] tracking-widest\" data-kid=\"2-5-1-2-1-2-3-4-1\" data-name=\"status wrapper\">\n                                    <span class=\"w-1.5 h-1.5 bg-red-500\" data-kid=\"2-5-1-2-1-2-3-4-1-1\" data-name=\"status indicator\">\n                                    </span>\n                                    Failed\n                                </span>\n                            </td>\n                            <td class=\"py-6 text-right text-slate-400 font-bold\" data-kid=\"2-5-1-2-1-2-3-5\" data-name=\"steps cell\">\n                                02 / 12\n                            </td>\n                        </tr>\n                        <tr class=\"hairline-b border-slate-900 group hover:bg-slate-900/40 reveal-row cursor-pointer transition-colors\" data-kid=\"2-5-1-2-1-2-4\" data-name=\"table data row 4\">\n                            <td class=\"py-6 text-white font-bold\" data-kid=\"2-5-1-2-1-2-4-1\" data-name=\"id cell\">\n                                #fl_5595_d\n                            </td>\n                            <td class=\"py-6 text-slate-500\" data-kid=\"2-5-1-2-1-2-4-2\" data-name=\"trigger cell\">\n                                webhook.in\n                            </td>\n                            <td class=\"py-6 text-slate-500\" data-kid=\"2-5-1-2-1-2-4-3\" data-name=\"runtime cell\">\n                                1.45s\n                            </td>\n                            <td class=\"py-6\" data-kid=\"2-5-1-2-1-2-4-4\" data-name=\"status cell\">\n                                <span class=\"flex items-center gap-3 text-mint font-bold uppercase text-[10px] tracking-widest\" data-kid=\"2-5-1-2-1-2-4-4-1\" data-name=\"status wrapper\">\n                                    <span class=\"w-1.5 h-1.5 bg-mint\" data-kid=\"2-5-1-2-1-2-4-4-1-1\" data-name=\"status indicator\">\n                                    </span>\n                                    Success\n                                </span>\n                            </td>\n                            <td class=\"py-6 text-right text-slate-400 font-bold\" data-kid=\"2-5-1-2-1-2-4-5\" data-name=\"steps cell\">\n                                12 / 12\n                            </td>\n                        </tr>\n                        <tr class=\"hairline-b border-slate-900 group hover:bg-slate-900/40 reveal-row cursor-pointer transition-colors\" data-kid=\"2-5-1-2-1-2-5\" data-name=\"table data row 5\">\n                            <td class=\"py-6 text-white font-bold\" data-kid=\"2-5-1-2-1-2-5-1\" data-name=\"id cell\">\n                                #fl_5596_e\n                            </td>\n                            <td class=\"py-6 text-slate-500\" data-kid=\"2-5-1-2-1-2-5-2\" data-name=\"trigger cell\">\n                                api.manual\n                            </td>\n                            <td class=\"py-6 text-slate-500\" data-kid=\"2-5-1-2-1-2-5-3\" data-name=\"runtime cell\">\n                                2.1s\n                            </td>\n                            <td class=\"py-6\" data-kid=\"2-5-1-2-1-2-5-4\" data-name=\"status cell\">\n                                <span class=\"flex items-center gap-3 text-mint font-bold uppercase text-[10px] tracking-widest\" data-kid=\"2-5-1-2-1-2-5-4-1\" data-name=\"status wrapper\">\n                                    <span class=\"w-1.5 h-1.5 bg-mint\" data-kid=\"2-5-1-2-1-2-5-4-1-1\" data-name=\"status indicator\">\n                                    </span>\n                                    Success\n                                </span>\n                            </td>\n                            <td class=\"py-6 text-right text-slate-400 font-bold\" data-kid=\"2-5-1-2-1-2-5-5\" data-name=\"steps cell\">\n                                08 / 08\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"py-32 px-6 hairline-t bg-[#14111c] relative overflow-hidden\" data-kid=\"2-6\" data-name=\"footer section\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 relative z-10\" data-kid=\"2-6-1\" data-name=\"footer inner grid\">\n            <div class=\"lg:col-span-8 space-y-12\" data-kid=\"2-6-1-1\" data-name=\"footer content column\">\n                <div class=\"space-y-4\" data-kid=\"2-6-1-1-1\" data-name=\"footer headline group\">\n                    <span class=\"text-mint font-mono text-[10px] uppercase tracking-[0.3em]\" data-kid=\"2-6-1-1-1-1\" data-name=\"deployment status label\">\n                        Deployment Status: v1.0.0-STABLE\n                    </span>\n                    <h2 class=\"font-heading text-6xl md:text-8xl font-black text-white uppercase tracking-tighter leading-[0.85]\" data-kid=\"2-6-1-1-1-2\" data-name=\"footer headline\">\n                        Durable execution\n                        <br data-kid=\"2-6-1-1-1-2-1\" data-name=\"headline break\"/>\n                        <span class=\"text-mint\" data-kid=\"2-6-1-1-1-2-2\" data-name=\"footer headline primary focus\">\n                            is the default.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"flex flex-wrap gap-8 items-center\" data-kid=\"2-6-1-1-2\" data-name=\"footer action group\">\n                    <button class=\"bg-mint text-midnight px-10 py-5 font-black uppercase text-lg cursor-pointer hover:bg-white transition-all transform hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(163,247,116,0.2)]\" data-kid=\"2-6-1-1-2-1\" data-name=\"footer deploy worker button\">\n                        Deploy your first worker\n                    </button>\n                    <div class=\"font-mono text-[9px] text-slate-500 uppercase leading-relaxed tracking-widest border-l border-slate-700 pl-6 hidden md:block\" data-kid=\"2-6-1-1-2-2\" data-name=\"footer supported platforms\">\n                        Available now for\n                        <br data-kid=\"2-6-1-1-2-2-1\" data-name=\"supported platforms break\"/>\n                        Node.js · Typescript · Bun\n                    </div>\n                </div>\n            </div>\n            <div class=\"lg:col-span-4 flex flex-col justify-between border-l border-slate-800 pl-8\" data-kid=\"2-6-1-2\" data-name=\"footer links and copyright column\">\n                <div class=\"space-y-8\" data-kid=\"2-6-1-2-1\" data-name=\"footer links container\">\n                    <div data-kid=\"2-6-1-2-1-1\" data-name=\"footer core documentation block\">\n                        <h4 class=\"text-slate-400 text-[10px] font-mono uppercase tracking-[0.2em] mb-4\" data-kid=\"2-6-1-2-1-1-1\" data-name=\"documentation title\">\n                            Core Documentation\n                        </h4>\n                        <ul class=\"space-y-3 text-sm font-bold uppercase tracking-tighter\" data-kid=\"2-6-1-2-1-1-2\" data-name=\"documentation links\">\n                            <li data-kid=\"2-6-1-2-1-1-2-1\" data-name=\"link container\">\n                                <a class=\"hover:text-mint transition-colors\" data-kid=\"2-6-1-2-1-1-2-1-1\" data-name=\"doc link 1\" href=\"#\">\n                                    Getting Started\n                                </a>\n                            </li>\n                            <li data-kid=\"2-6-1-2-1-1-2-2\" data-name=\"link container\">\n                                <a class=\"hover:text-mint transition-colors\" data-kid=\"2-6-1-2-1-1-2-2-1\" data-name=\"doc link 2\" href=\"#\">\n                                    Engine Primitives\n                                </a>\n                            </li>\n                            <li data-kid=\"2-6-1-2-1-1-2-3\" data-name=\"link container\">\n                                <a class=\"hover:text-mint transition-colors\" data-kid=\"2-6-1-2-1-1-2-3-1\" data-name=\"doc link 3\" href=\"#\">\n                                    BullMQ Integration\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"2-6-1-2-1-2\" data-name=\"footer infrastructure block\">\n                        <h4 class=\"text-slate-400 text-[10px] font-mono uppercase tracking-[0.2em] mb-4\" data-kid=\"2-6-1-2-1-2-1\" data-name=\"infrastructure title\">\n                            Infrastructure\n                        </h4>\n                        <ul class=\"space-y-3 text-sm font-bold uppercase tracking-tighter\" data-kid=\"2-6-1-2-1-2-2\" data-name=\"infrastructure links\">\n                            <li data-kid=\"2-6-1-2-1-2-2-1\" data-name=\"link container\">\n                                <a class=\"hover:text-mint transition-colors\" data-kid=\"2-6-1-2-1-2-2-1-1\" data-name=\"infra link 1\" href=\"#\">\n                                    Cloud Status\n                                </a>\n                            </li>\n                            <li data-kid=\"2-6-1-2-1-2-2-2\" data-name=\"link container\">\n                                <a class=\"hover:text-mint transition-colors\" data-kid=\"2-6-1-2-1-2-2-2-1\" data-name=\"infra link 2\" href=\"#\">\n                                    Self-Hosting\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n                <div class=\"text-[9px] font-mono text-slate-700 uppercase tracking-widest mt-12\" data-kid=\"2-6-1-2-2\" data-name=\"footer copyright text\">\n                    © 2024 FLOWLINE / OPEN-SOURCE CORE\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute bottom-0 left-0 w-full opacity-5 pointer-events-none h-64 translate-y-1/2\" data-kid=\"2-6-2\" data-name=\"footer decorative wave background\">\n            <svg class=\"w-full h-full\" data-kid=\"2-6-2-1\" data-name=\"footer wave svg\" viewbox=\"0 0 1000 200\">\n                <path d=\"M 0 200 Q 250 50 500 150 T 1000 100\" fill=\"none\" stroke=\"var(--mint)\" stroke-width=\"4\">\n                </path>\n            </svg>\n        </div>\n    </footer>\n</div>\n<!-- JS Libraries -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\";\n    \n    const lenis = new Lenis();\n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    document.getElementById('scroll-engine-btn').addEventListener('click', () => {\n        lenis.scrollTo('#engine');\n    });\n\n    const heroTl = gsap.timeline();\n    heroTl.from(\".hero-text\", { y: 60, opacity: 0, duration: 1.2, ease: \"power4.out\" })\n          .from(\".hero-visual\", { x: 40, opacity: 0, duration: 1.2, ease: \"power4.out\" }, \"-=1\")\n          .from(\".node-group\", { scale: 0, opacity: 0, stagger: 0.1, duration: 0.8, ease: \"back.out(2)\" }, \"-=0.8\");\n\n    const dashMain = document.querySelector(\"#flow-path-main\");\n    const dashSub = document.querySelector(\"#flow-path-sub\");\n    \n    gsap.to(dashMain, {\n        strokeDashoffset: -1000,\n        duration: 10,\n        repeat: -1,\n        ease: \"none\"\n    });\n    gsap.to(dashSub, {\n        strokeDashoffset: -1000,\n        duration: 7,\n        repeat: -1,\n        ease: \"none\"\n    });\n\n    const nodes = document.querySelectorAll(\".node-pulse\");\n    let activeNodeIdx = 0;\n    setInterval(() => {\n        nodes.forEach(n => n.classList.remove(\"active-node\"));\n        nodes[activeNodeIdx].classList.add(\"active-node\");\n        activeNodeIdx = (activeNodeIdx + 1) % nodes.length;\n    }, 1000);\n\n    gsap.from(\".bento-cell\", {\n        scrollTrigger: {\n            trigger: \"#engine\",\n            start: \"top 85%\",\n        },\n        y: 40,\n        opacity: 0,\n        stagger: 0.15,\n        duration: 1,\n        ease: \"power3.out\"\n    });\n\n    gsap.to(\".mask-container\", {\n        scrollTrigger: {\n            trigger: \".mask-container\",\n            start: \"top 75%\",\n            end: \"top 35%\",\n            scrub: 0.5,\n        },\n        clipPath: \"inset(0 0% 0 0)\",\n        ease: \"none\"\n    });\n\n    gsap.from(\".reveal-row\", {\n        scrollTrigger: {\n            trigger: \"#traces\",\n            start: \"top 75%\",\n        },\n        y: 20,\n        opacity: 0,\n        stagger: 0.08,\n        duration: 0.8,\n        ease: \"power2.out\"\n    });\n\n    if (window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches) {\n        gsap.globalTimeline.clear();\n        gsap.set(\".hero-text, .hero-visual, .node-group, .bento-cell, .reveal-row\", { opacity: 1, y: 0, x: 0, scale: 1 });\n        gsap.set(\".mask-container\", { clipPath: \"inset(0 0 0 0)\" });\n    }\n</script>\n",
      "comments": [],
      "created": "2026-08-06T05:47:10.532950+00:00",
      "modified": "2026-08-06T05:47:10.532950+00:00",
      "id": "var_4a574c59d34f",
      "overrides": {
        "htmlAttrs": " lang=\"en\"",
        "bodyAttrs": " class=\"graph-paper\"",
        "head": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Flowline — Architecture First</title>\n    \n    <!-- GSAP & Plugins -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n    <!-- Lenis for smooth scroll -->"
      }
    },
    "var_960f99400dcb": {
      "type": "variant",
      "label": "Flowline — Command Center",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen overflow-x-clip bg-[#1a1625] text-white selection:bg-[#c4f542] selection:text-[#1a1625] font-['IBM_Plex_Sans']\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inconsolata:wght@500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      --flow-bg: #1a1625;\n      --flow-surface: #2d2640;\n      --flow-surface-2: #241e33;\n      --flow-border: #3d3356;\n      --flow-ink: #f3f1f7;\n      --flow-muted: #aaa4b8;\n      --flow-dim: #766d88;\n      --flow-lime: #c4f542;\n      --flow-blue: #7fa7ff;\n      --flow-amber: #e5b84b;\n    }\n\n    .font-mono { font-family: 'Inconsolata', monospace; }\n    .font-sans { font-family: 'IBM Plex Sans', sans-serif; }\n    .grid-pattern {\n      background-image: linear-gradient(to right, rgba(196,245,66,.045) 1px, transparent 1px), linear-gradient(to bottom, rgba(196,245,66,.045) 1px, transparent 1px);\n      background-size: 40px 40px;\n    }\n    .dot-pattern {\n      background-image: radial-gradient(rgba(196,245,66,.2) 1px, transparent 1px);\n      background-size: 18px 18px;\n    }\n    .hairline { border-color: var(--flow-border); }\n    .surface { background: var(--flow-surface-2); }\n    .terminal-grid { background-color: rgba(26,22,37,.86); }\n    .interactive-link:hover { color: var(--flow-lime); }\n    .interactive-link:focus-visible,\n    .primary-action:focus-visible,\n    .secondary-action:focus-visible,\n    .demo-control:focus-visible {\n      outline: 2px solid var(--flow-lime);\n      outline-offset: 4px;\n    }\n    .feature-link:hover { color: var(--flow-lime); border-color: var(--flow-lime); }\n    .primary-action:hover { background: #e1ff87; }\n    .secondary-action:hover { border-color: var(--flow-lime); color: var(--flow-lime); }\n    .demo-control:hover { background: var(--flow-surface); color: var(--flow-lime); }\n    .text-\\[\\#766d88\\] { color: #8a829e !important; }\n    [class~=\"text-[#766d88]\"] { color: #8a829e !important; }\n    .flow-node { position: absolute; transform: translate(-50%, -50%); }\n    .flow-node.is-active { border-color: var(--flow-lime); box-shadow: 0 0 0 1px rgba(196,245,66,.18), 0 0 24px rgba(196,245,66,.14); }\n    .flow-node.is-active .node-value { color: var(--flow-lime); }\n    .section-rule { background-color: var(--flow-border) !important; transform-origin: left center; transform: scaleX(0); }\n    [data-name=\"delay feature title\"], [data-name=\"retry feature title\"], [data-name=\"ai badge\"] { color: var(--flow-ink) !important; }\n    [data-name=\"ai badge\"] { border-color: var(--flow-border) !important; }\n    .trigger-progress { transform: scaleX(0); transform-origin: left center; }\n    .trace-row:hover { background: rgba(45,38,64,.42); }\n    .custom-scrollbar::-webkit-scrollbar { width: 4px; }\n    .custom-scrollbar::-webkit-scrollbar-track { background: var(--flow-bg); }\n    .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--flow-surface); }\n    @media (prefers-reduced-motion: reduce) {\n      .flow-node { box-shadow: none !important; }\n      .section-rule { transform: scaleX(1); }\n    }\n    </style>\n    <nav aria-label=\"Primary navigation\" class=\"fixed left-0 right-0 top-0 z-50 border-b hairline bg-[#1a1625]/95 backdrop-blur-md\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <div class=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8\" data-kid=\"1-1-1\" data-name=\"navigation content wrapper\">\n            <div class=\"flex items-center gap-10\" data-kid=\"1-1-1-1\" data-name=\"brand and navigation links group\">\n                <a aria-label=\"Flowline home\" class=\"interactive-link flex items-center gap-2 font-mono font-bold tracking-[-0.05em] text-xl\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo anchor\" href=\"#top\">\n                    <span class=\"flex h-6 w-6 items-center justify-center bg-[#c4f542] text-xs font-black text-[#1a1625]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon\">\n                        F\n                    </span>\n                    FLOWLINE\n                </a>\n                <div class=\"hidden items-center gap-7 font-mono text-xs uppercase tracking-[0.18em] text-[#aaa4b8] md:flex\" data-kid=\"1-1-1-1-2\" data-name=\"navigation menu links\">\n                    <a class=\"interactive-link\" data-kid=\"1-1-1-1-2-1\" data-name=\"navigation menu link 1\" href=\"#engine\">\n                        Engine\n                    </a>\n                    <a class=\"interactive-link\" data-kid=\"1-1-1-1-2-2\" data-name=\"navigation menu link 2\" href=\"#traces\">\n                        Traces\n                    </a>\n                    <a class=\"interactive-link\" data-kid=\"1-1-1-1-2-3\" data-name=\"navigation menu link 3\" href=\"#docs\">\n                        Docs\n                    </a>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-2\" data-name=\"navigation actions group\">\n                <div aria-label=\"Stack status\" class=\"hidden items-center gap-3 font-mono text-[12px] uppercase tracking-[0.12em] text-[#766d88] lg:flex\" data-kid=\"1-1-1-2-1\" data-name=\"stack status\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-1-1\" data-name=\"node status label\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#c4f542]\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"node status indicator\">\n                        </span>\n                        Node\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-1-2\" data-name=\"bullmq status label\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#c4f542]\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"bullmq status indicator\">\n                        </span>\n                        BullMQ\n                    </span>\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-1-3\" data-name=\"postgres status label\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#c4f542]\" data-kid=\"1-1-1-2-1-3-1\" data-name=\"postgres status indicator\">\n                        </span>\n                        Postgres\n                    </span>\n                </div>\n                <a class=\"primary-action bg-[#c4f542] px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-[0.12em] text-[#1a1625]\" data-kid=\"1-1-1-2-2\" data-name=\"get started call-to-action button\" href=\"#get-started\">\n                    Get started\n                </a>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"relative flex min-h-[860px] items-center overflow-hidden px-6 pb-24 pt-32 lg:px-8\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"pointer-events-none absolute inset-0 dot-pattern opacity-35\" data-kid=\"1-2-1-1\" data-name=\"hero background decorative pattern\">\n            </div>\n            <div class=\"relative z-10 mx-auto grid w-full max-w-7xl items-center gap-14 lg:grid-cols-[minmax(0,0.83fr)_minmax(0,1.17fr)] lg:gap-16\" data-kid=\"1-2-1-2\" data-name=\"hero content grid container\">\n                <div class=\"max-w-xl\" data-kid=\"1-2-1-2-1\" data-name=\"hero text content\">\n                    <div class=\"mb-8 inline-flex items-center gap-2 border hairline bg-[#2d2640]/55 px-3 py-2 font-mono text-xs uppercase tracking-[0.18em] text-[#c4f542]\" data-kid=\"1-2-1-2-1-1\" data-name=\"hero tag\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#c4f542]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"hero tag indicator\">\n                        </span>\n                        Async workflow engine\n                    </div>\n                    <h1 class=\"font-mono text-6xl font-extrabold leading-[0.88] tracking-[-0.06em] text-[#f3f1f7] sm:text-7xl lg:text-[5.25rem]\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero headline\" id=\"hero-title\">\n                        Async\n                        <br data-kid=\"1-2-1-2-1-2-1\" data-name=\"hero headline line break 1\"/>\n                        workflows,\n                        <br data-kid=\"1-2-1-2-1-2-2\" data-name=\"hero headline line break 2\"/>\n                        <span class=\"text-[#c4f542]\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"hero headline highlight text\">\n                            uncompromised.\n                        </span>\n                    </h1>\n                    <p class=\"mt-10 max-w-lg font-sans text-lg leading-8 text-[#aaa4b8] sm:text-xl\" data-kid=\"1-2-1-2-1-3\" data-name=\"hero description text\">\n                        A technical core for orchestrating Node.js pipelines with BullMQ durability and PostgreSQL state persistence.\n                    </p>\n                    <div class=\"mt-10 flex flex-wrap items-center gap-5\" data-kid=\"1-2-1-2-1-4\" data-name=\"hero action button group\">\n                        <a class=\"primary-action inline-flex items-center justify-center bg-[#c4f542] px-7 py-4 font-mono text-base font-bold uppercase tracking-[0.1em] text-[#1a1625]\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"hero primary get started button\" href=\"#get-started\">\n                            Get started\n                        </a>\n                        <a class=\"secondary-action inline-flex items-center gap-3 border-b border-[#3d3356] pb-1 font-mono text-sm text-[#c4f542]\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"hero secondary scroll link\" href=\"#diagram\">\n                            See how it works\n                            <span aria-hidden=\"true\" data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"hero scroll link arrow\">\n                                →\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"mt-12 grid max-w-md grid-cols-2 border-t hairline pt-5 font-mono text-xs uppercase tracking-[0.12em] text-[#766d88] sm:grid-cols-3\" data-kid=\"1-2-1-2-1-5\" data-name=\"hero feature highlights list\">\n                        <span data-kid=\"1-2-1-2-1-5-1\" data-name=\"feature highlight 1\">\n                            Webhooks\n                        </span>\n                        <span class=\"border-l hairline pl-4\" data-kid=\"1-2-1-2-1-5-2\" data-name=\"feature highlight 2\">\n                            Durable state\n                        </span>\n                        <span class=\"mt-3 border-l hairline pl-4 sm:mt-0\" data-kid=\"1-2-1-2-1-5-3\" data-name=\"feature highlight 3\">\n                            AI transforms\n                        </span>\n                    </div>\n                </div>\n                <div aria-label=\"Flowline sample workflow diagram\" class=\"scroll-mt-24 border-2 hairline bg-[#1a1625]\" data-kid=\"1-2-1-2-2\" data-name=\"terminal interface\" id=\"diagram\">\n                    <div class=\"flex items-center justify-between border-b hairline bg-[#2d2640]/30 px-4 py-3 font-mono text-xs uppercase tracking-[0.13em]\" data-kid=\"1-2-1-2-2-1\" data-name=\"terminal header bar\">\n                        <div class=\"flex items-center gap-3 text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"terminal window controls group\">\n                            <span class=\"h-2 w-2 bg-[#3d3356]\" data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"terminal window control icon\">\n                            </span>\n                            <span data-kid=\"1-2-1-2-2-1-1-2\" data-name=\"terminal path text\">\n                                flowline / pipeline.run\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-4 text-[#766d88]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"terminal status group\">\n                            <span class=\"hidden sm:inline\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"terminal status text\">\n                                Sample execution\n                            </span>\n                            <span class=\"text-[#c4f542]\" data-kid=\"1-2-1-2-2-1-2-2\" data-name=\"terminal status blinker\">\n                                ● Ready\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"terminal-grid grid-pattern relative h-[470px] overflow-x-auto overflow-y-hidden\" data-kid=\"1-2-1-2-2-2\" data-name=\"terminal output area with horizontal scroll\">\n                        <svg aria-hidden=\"true\" class=\"absolute inset-0 min-w-[760px] h-full w-full\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"workflow diagram svg\" fill=\"none\" id=\"workflow-svg\" viewbox=\"0 0 760 470\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M100 215 H250\" id=\"path-trigger-branch\" stroke=\"#3d3356\" stroke-width=\"2\">\n                            </path>\n                            <path d=\"M250 215 H420\" id=\"path-branch-delay\" stroke=\"#3d3356\" stroke-width=\"2\">\n                            </path>\n                            <path d=\"M420 215 H590\" id=\"path-delay-ai\" stroke=\"#3d3356\" stroke-width=\"2\">\n                            </path>\n                            <path d=\"M250 215 V105 H420 V215\" id=\"path-branch-alt\" opacity=\".65\" stroke=\"#3d3356\" stroke-dasharray=\"5 7\" stroke-width=\"1.5\">\n                            </path>\n                            <circle cx=\"100\" cy=\"215\" fill=\"#c4f542\" id=\"flow-packet\" r=\"5\" style=\"filter: drop-shadow(0 0 8px #c4f542);\">\n                            </circle>\n                        </svg>\n                        <div class=\"absolute left-4 top-4 font-mono text-xs uppercase tracking-[0.15em] text-[#766d88]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"workflow graph label\">\n                            Workflow graph / sample data\n                        </div>\n                        <div class=\"flow-node w-36 border-2 hairline bg-[#1a1625] p-4 font-mono\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"trigger node\" id=\"node-trigger\" style=\"left: 100px; top: 215px;\">\n                            <div class=\"flex items-center justify-between text-xs text-[#766d88]\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"trigger node header\">\n                                <span data-kid=\"1-2-1-2-2-2-3-1-1\" data-name=\"trigger node title\">\n                                    Trigger\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-webhook text-base text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-2-3-1-2\" data-name=\"trigger node icon\">\n                                </i>\n                            </div>\n                            <div class=\"node-value mt-8 text-sm text-[#f3f1f7]\" data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"trigger node value text\">\n                                Webhook.run\n                            </div>\n                            <div class=\"mt-3 h-1 bg-[#2d2640]\" data-kid=\"1-2-1-2-2-2-3-3\" data-name=\"trigger node progress bar container\">\n                                <div class=\"trigger-progress h-full w-full bg-[#c4f542]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-3-3-1\" data-name=\"trigger node progress filler\" data-reason=\"transform updated by animation script\" id=\"trigger-progress\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flow-node w-36 border-2 hairline bg-[#1a1625] p-4 font-mono\" data-kid=\"1-2-1-2-2-2-4\" data-name=\"branch node\" id=\"node-branch\" style=\"left: 250px; top: 215px;\">\n                            <div class=\"flex items-center justify-between text-xs text-[#766d88]\" data-kid=\"1-2-1-2-2-2-4-1\" data-name=\"branch node header\">\n                                <span data-kid=\"1-2-1-2-2-2-4-1-1\" data-name=\"branch node title\">\n                                    Branch\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-git-branch text-base text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-2-4-1-2\" data-name=\"branch node icon\">\n                                </i>\n                            </div>\n                            <div class=\"mt-8 border hairline bg-[#2d2640]/35 py-1 text-center text-xs text-[#7fa7ff]\" data-kid=\"1-2-1-2-2-2-4-2\" data-name=\"branch node condition box\">\n                                is_valid?\n                            </div>\n                            <div class=\"mt-3 flex justify-between text-xs uppercase text-[#766d88]\" data-kid=\"1-2-1-2-2-2-4-3\" data-name=\"branch node footer\">\n                                <span data-kid=\"1-2-1-2-2-2-4-3-1\" data-name=\"branch node option 1\">\n                                    ok\n                                </span>\n                                <span data-kid=\"1-2-1-2-2-2-4-3-2\" data-name=\"branch node option 2\">\n                                    retry\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"flow-node w-36 border-2 hairline bg-[#1a1625] p-4 font-mono\" data-kid=\"1-2-1-2-2-2-5\" data-name=\"delay node\" id=\"node-delay\" style=\"left: 420px; top: 215px;\">\n                            <div class=\"flex items-center justify-between text-xs text-[#766d88]\" data-kid=\"1-2-1-2-2-2-5-1\" data-name=\"delay node header\">\n                                <span data-kid=\"1-2-1-2-2-2-5-1-1\" data-name=\"delay node title\">\n                                    Delay\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-clock text-base text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-2-5-1-2\" data-name=\"delay node icon\">\n                                </i>\n                            </div>\n                            <div class=\"node-value mt-8 text-sm text-[#f3f1f7]\" data-kid=\"1-2-1-2-2-2-5-2\" data-name=\"delay node value text\">\n                                Wait 10m\n                            </div>\n                            <div class=\"mt-3 flex justify-between text-xs uppercase text-[#766d88]\" data-kid=\"1-2-1-2-2-2-5-3\" data-name=\"delay node footer\">\n                                <span data-kid=\"1-2-1-2-2-2-5-3-1\" data-name=\"delay node label 1\">\n                                    PgSQL state\n                                </span>\n                                <span data-kid=\"1-2-1-2-2-2-5-3-2\" data-name=\"delay node label 2\">\n                                    durable\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"flow-node w-36 border-2 hairline bg-[#1a1625] p-4 font-mono\" data-kid=\"1-2-1-2-2-2-6\" data-name=\"ai node\" id=\"node-ai\" style=\"left: 590px; top: 215px;\">\n                            <div class=\"flex items-center justify-between text-xs text-[#766d88]\" data-kid=\"1-2-1-2-2-2-6-1\" data-name=\"ai node header\">\n                                <span data-kid=\"1-2-1-2-2-2-6-1-1\" data-name=\"ai node title\">\n                                    AI transform\n                                </span>\n                                <span class=\"text-sm text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-2-6-1-2\" data-name=\"ai node icon text\">\n                                    AI\n                                </span>\n                            </div>\n                            <div class=\"node-value mt-8 text-sm text-[#f3f1f7]\" data-kid=\"1-2-1-2-2-2-6-2\" data-name=\"ai node value text\">\n                                OpenRouter\n                            </div>\n                            <div class=\"mt-3 text-xs text-[#766d88]\" data-kid=\"1-2-1-2-2-2-6-3\" data-name=\"ai node footer text\">\n                                → structured output\n                            </div>\n                        </div>\n                        <div class=\"absolute bottom-0 left-0 right-0 border-t hairline bg-[#1a1625]/95 px-5 py-4 font-mono\" data-kid=\"1-2-1-2-2-2-7\" data-name=\"terminal footer log section\">\n                            <div class=\"mb-3 flex flex-wrap items-center justify-between gap-3 text-xs uppercase tracking-[0.13em] text-[#766d88]\" data-kid=\"1-2-1-2-2-2-7-1\" data-name=\"terminal log metadata header\">\n                                <span data-kid=\"1-2-1-2-2-2-7-1-1\" data-name=\"terminal log description\">\n                                    Example trace / illustrative\n                                </span>\n                                <span data-kid=\"1-2-1-2-2-2-7-1-2\" data-name=\"terminal log session identifier\">\n                                    trace_id: demo_88192a\n                                </span>\n                            </div>\n                            <div class=\"grid gap-2 text-xs sm:grid-cols-3\" data-kid=\"1-2-1-2-2-2-7-2\" data-name=\"terminal log sample row\">\n                                <span class=\"text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-2-7-2-1\" data-name=\"terminal log event 1\">\n                                    14:20:01\n                                    <b class=\"font-normal text-[#c4f542]\" data-kid=\"1-2-1-2-2-2-7-2-1-1\" data-name=\"terminal log event label 1\">\n                                        EVENT_INGESTED\n                                    </b>\n                                </span>\n                                <span class=\"text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-2-7-2-2\" data-name=\"terminal log event 2\">\n                                    14:20:02\n                                    <b class=\"font-normal text-[#7fa7ff]\" data-kid=\"1-2-1-2-2-2-7-2-2-1\" data-name=\"terminal log event label 2\">\n                                        BRANCH_EVAL\n                                    </b>\n                                </span>\n                                <span class=\"text-[#aaa4b8]\" data-kid=\"1-2-1-2-2-2-7-2-3\" data-name=\"terminal log event 3\">\n                                    14:20:03\n                                    <b class=\"font-normal text-[#e5b84b]\" data-kid=\"1-2-1-2-2-2-7-2-3-1\" data-name=\"terminal log event label 3\">\n                                        STATE_PERSISTED\n                                    </b>\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-wrap items-center justify-between gap-4 border-t hairline bg-[#2d2640]/20 px-4 py-3\" data-kid=\"1-2-1-2-2-3\" data-name=\"terminal controls strip\">\n                        <p class=\"font-mono text-xs text-[#766d88]\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"terminal controls text\">\n                            Sequence: trigger → branch → delay → AI\n                        </p>\n                        <button aria-pressed=\"true\" class=\"demo-control border hairline px-3 py-2 font-mono text-xs uppercase tracking-[0.12em] text-[#aaa4b8]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"terminal demo control button\" data-reason=\"text and attribute updated by demo state script\" id=\"demo-toggle\" type=\"button\">\n                            Play demo\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"engine-title\" class=\"scroll-mt-24 border-t hairline px-6 py-28 lg:px-8\" data-kid=\"1-2-2\" data-name=\"engine section\" id=\"engine\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-2-1\" data-name=\"engine content wrapper\">\n                <div class=\"mb-12 flex items-end justify-between gap-8\" data-kid=\"1-2-2-1-1\" data-name=\"engine header section\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"engine section intro\">\n                        <div class=\"mb-5 font-mono text-xs uppercase tracking-[0.18em] text-[#766d88]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"engine section sublabel\">\n                            Engine primitives\n                        </div>\n                        <div class=\"section-rule mb-5 h-px w-24 bg-[#c4f542]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"engine section decorative rule\">\n                        </div>\n                        <h2 class=\"font-mono text-4xl font-bold tracking-[-0.04em] sm:text-5xl\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"engine section headline\" id=\"engine-title\">\n                            The engine is the product.\n                        </h2>\n                    </div>\n                    <p class=\"hidden max-w-sm text-right font-sans text-sm leading-6 text-[#aaa4b8] md:block\" data-kid=\"1-2-2-1-1-2\" data-name=\"engine section description text\">\n                        Every surface below maps to a real execution concern: ingest, branch, persist, retry, transform, observe.\n                    </p>\n                </div>\n                <div class=\"grid gap-5 lg:grid-cols-12\" data-kid=\"1-2-2-1-2\" data-name=\"engine feature grid\">\n                    <article class=\"feature-card border hairline bg-[#2d2640]/15 p-8 lg:col-span-8 lg:p-10\" data-kid=\"1-2-2-1-2-1\" data-name=\"large feature card\">\n                        <div class=\"grid gap-8 lg:grid-cols-[1fr_260px] lg:items-start\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"feature card inner layout\">\n                            <div data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"feature card text area\">\n                                <div class=\"mb-4 font-mono text-xs uppercase tracking-[0.17em] text-[#766d88]\" data-kid=\"1-2-2-1-2-1-1-1-1\" data-name=\"feature card category\">\n                                    01 / ingest\n                                </div>\n                                <h3 class=\"font-mono text-3xl font-bold tracking-[-0.04em] text-[#f3f1f7]\" data-kid=\"1-2-2-1-2-1-1-1-2\" data-name=\"feature card title\">\n                                    Webhook + polling triggers\n                                </h3>\n                                <p class=\"mt-5 max-w-xl text-base leading-7 text-[#aaa4b8]\" data-kid=\"1-2-2-1-2-1-1-1-3\" data-name=\"feature card description\">\n                                    Receive events from an HTTP webhook or a polling loop, validate the payload, then enqueue work with BullMQ without losing the original trigger context.\n                                </p>\n                                <a class=\"feature-link mt-8 inline-flex border-b border-[#3d3356] pb-1 font-mono text-xs uppercase tracking-[0.13em] text-[#aaa4b8]\" data-kid=\"1-2-2-1-2-1-1-1-4\" data-name=\"feature card link\" href=\"#diagram\">\n                                    Inspect trigger path →\n                                </a>\n                            </div>\n                            <pre class=\"overflow-x-auto border hairline bg-[#1a1625] p-4 font-mono text-xs leading-6 text-[#aaa4b8]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"feature card code preview block\"><code data-kid=\"1-2-2-1-2-1-1-2-1\" data-name=\"feature card code snippet\"><span class=\"text-[#c4f542]\" data-kid=\"1-2-2-1-2-1-1-2-1-1\" data-name=\"code snippet status\">POST</span> /webhooks/in\n<span class=\"text-[#766d88]\" data-kid=\"1-2-2-1-2-1-1-2-1-2\" data-name=\"code snippet endpoint\">x-flowline-signature:</span> sha256…\n\n{\n  <span class=\"text-[#7fa7ff]\" data-kid=\"1-2-2-1-2-1-1-2-1-3\" data-name=\"code snippet property 1\">\"event\"</span>: \"user.signup\",\n  <span class=\"text-[#7fa7ff]\" data-kid=\"1-2-2-1-2-1-1-2-1-4\" data-name=\"code snippet property 2\">\"attempt\"</span>: 1,\n  <span class=\"text-[#7fa7ff]\" data-kid=\"1-2-2-1-2-1-1-2-1-5\" data-name=\"code snippet property 3\">\"idempotency_key\"</span>: \"evt_42\"\n}</code></pre>\n                        </div>\n                    </article>\n                    <article class=\"feature-card border hairline bg-[#2d2640]/15 p-8 lg:col-span-4 lg:p-10\" data-kid=\"1-2-2-1-2-2\" data-name=\"small feature card\">\n                        <div class=\"mb-4 font-mono text-xs uppercase tracking-[0.17em] text-[#766d88]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"small card category\">\n                            02 / control flow\n                        </div>\n                        <h3 class=\"font-mono text-2xl font-bold tracking-[-0.03em]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"small card title\">\n                            Conditional paths\n                        </h3>\n                        <p class=\"mt-5 text-base leading-7 text-[#aaa4b8]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"small card description\">\n                            Evaluate JSON keys or external responses and route each execution down the path it actually qualifies for.\n                        </p>\n                        <svg aria-label=\"Conditional split and rejoin diagram\" class=\"mt-9 h-20 w-full\" data-kid=\"1-2-2-1-2-2-4\" data-name=\"small card diagram svg\" fill=\"none\" viewbox=\"0 0 280 80\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M16 40H86M86 40L142 14H260M86 40L142 66H260\" stroke=\"#3d3356\" stroke-width=\"2\">\n                            </path>\n                            <circle cx=\"86\" cy=\"40\" fill=\"#c4f542\" r=\"5\">\n                            </circle>\n                            <circle cx=\"260\" cy=\"14\" fill=\"#7fa7ff\" r=\"4\">\n                            </circle>\n                            <circle cx=\"260\" cy=\"66\" fill=\"#e5b84b\" r=\"4\">\n                            </circle>\n                        </svg>\n                        <div class=\"mt-6 flex justify-between border-t hairline pt-4 font-mono text-xs uppercase tracking-[0.12em] text-[#766d88]\" data-kid=\"1-2-2-1-2-2-5\" data-name=\"small card footer\">\n                            <span data-kid=\"1-2-2-1-2-2-5-1\" data-name=\"small card label 1\">\n                                JSON predicate\n                            </span>\n                            <span data-kid=\"1-2-2-1-2-2-5-2\" data-name=\"small card label 2\">\n                                2 paths\n                            </span>\n                        </div>\n                    </article>\n                    <div class=\"border border-[#c4f542] bg-[#c4f542] p-6 text-[#1a1625] lg:col-span-12 lg:flex lg:items-center lg:justify-between lg:gap-10\" data-kid=\"1-2-2-1-2-3\" data-name=\"execution contract banner\">\n                        <div class=\"font-mono text-xl font-bold tracking-[-0.04em]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"execution contract title\">\n                            execution_contract_v1.0\n                        </div>\n                        <p class=\"mt-3 max-w-2xl text-sm font-semibold leading-6 lg:mt-0\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"execution contract description\">\n                            Idempotent triggers and persistent state keep the same event from running twice, even when a worker restarts mid-execution.\n                        </p>\n                        <div class=\"mt-3 font-mono text-xs uppercase tracking-[0.12em] text-[#1a1625]/65 lg:mt-0\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"execution contract technology\">\n                            PostgreSQL-backed\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"reliability-title\" class=\"border-t hairline px-6 py-32 lg:px-8\" data-kid=\"1-2-3\" data-name=\"reliability section\">\n            <div class=\"mx-auto max-w-5xl\" data-kid=\"1-2-3-1\" data-name=\"reliability content wrapper\">\n                <div class=\"mb-20 text-center\" data-kid=\"1-2-3-1-1\" data-name=\"reliability section intro\">\n                    <div class=\"mb-5 font-mono text-xs uppercase tracking-[0.18em] text-[#766d88]\" data-kid=\"1-2-3-1-1-1\" data-name=\"reliability category\">\n                        03 / reliability primitives\n                    </div>\n                    <div class=\"section-rule mx-auto mb-5 h-px w-24 bg-[#c4f542]\" data-kid=\"1-2-3-1-1-2\" data-name=\"reliability section decorative rule\">\n                    </div>\n                    <h2 class=\"font-mono text-4xl font-bold tracking-[-0.04em] sm:text-5xl\" data-kid=\"1-2-3-1-1-3\" data-name=\"reliability section headline\" id=\"reliability-title\">\n                        State survives the worker.\n                    </h2>\n                    <p class=\"mx-auto mt-5 max-w-2xl text-base leading-7 text-[#aaa4b8]\" data-kid=\"1-2-3-1-1-4\" data-name=\"reliability section description\">\n                        Flowline treats waiting, retrying, and resuming as first-class execution states—not edge cases hidden in a queue.\n                    </p>\n                </div>\n                <div class=\"relative\" data-kid=\"1-2-3-1-2\" data-name=\"reliability features timeline\">\n                    <div class=\"absolute bottom-0 left-1/2 top-0 hidden w-px -translate-x-1/2 bg-[#3d3356] md:block\" data-kid=\"1-2-3-1-2-1\" data-name=\"timeline central connector line\">\n                    </div>\n                    <div class=\"grid gap-16 md:grid-cols-2 md:gap-x-24 md:gap-y-28\" data-kid=\"1-2-3-1-2-2\" data-name=\"timeline grid\">\n                        <article class=\"border-l-2 border-[#c4f542] pl-6 md:border-l-0 md:border-r-2 md:pr-10 md:text-right\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"durable delay feature card\">\n                            <div class=\"mb-5 font-mono text-xs uppercase tracking-[0.17em] text-[#766d88]\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"delay feature category\">\n                                03 / durable delay\n                            </div>\n                            <h3 class=\"font-mono text-3xl font-bold tracking-[-0.04em] text-[#f3f1f7]\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"durable delay feature title\">\n                                Durable delay steps\n                            </h3>\n                            <p class=\"mt-5 text-base leading-7 text-[#aaa4b8]\" data-kid=\"1-2-3-1-2-2-1-3\" data-name=\"delay feature description\">\n                                Persist the next wake-up time and the exact step context in PostgreSQL. A worker can stop; the execution resumes from the saved state.\n                            </p>\n                            <pre class=\"mt-8 border hairline bg-[#2d2640]/25 p-4 text-left font-mono text-xs leading-6 text-[#aaa4b8]\" data-kid=\"1-2-3-1-2-2-1-4\" data-name=\"delay feature code block\"><code data-kid=\"1-2-3-1-2-2-1-4-1\" data-name=\"delay feature code snippet\"><span class=\"text-[#766d88]\" data-kid=\"1-2-3-1-2-2-1-4-1-1\" data-name=\"code property 1\">checkpoint</span>: postgres\n<span class=\"text-[#766d88]\" data-kid=\"1-2-3-1-2-2-1-4-1-2\" data-name=\"code property 2\">resume_at</span>: 2026-08-06T14:30:00Z\n<span class=\"text-[#766d88]\" data-kid=\"1-2-3-1-2-2-1-4-1-3\" data-name=\"code property 3\">step</span>: delay.wait_10m\n<span class=\"text-[#c4f542]\" data-kid=\"1-2-3-1-2-2-1-4-1-4\" data-name=\"code property 4\">status</span>: waiting</code></pre>\n                        </article>\n                        <article class=\"border-l-2 border-[#3d3356] pl-6 md:mt-28 md:border-l-2 md:pl-10\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"retry feature card\">\n                            <div class=\"mb-5 font-mono text-xs uppercase tracking-[0.17em] text-[#766d88]\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"retry feature category\">\n                                04 / delivery safety\n                            </div>\n                            <h3 class=\"font-mono text-3xl font-bold tracking-[-0.04em] text-[#f3f1f7]\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"retry feature card\">\n                                Exponential backoff\n                            </h3>\n                            <p class=\"mt-5 text-base leading-7 text-[#aaa4b8]\" data-kid=\"1-2-3-1-2-2-2-3\" data-name=\"retry feature description\">\n                                Retry failures with explicit windows, bounded attempts, and idempotency keys so a transient outage never becomes a duplicate side effect.\n                            </p>\n                            <div class=\"mt-8 border hairline bg-[#2d2640]/25 p-5 font-mono text-xs\" data-kid=\"1-2-3-1-2-2-2-4\" data-name=\"retry feature backoff visualization\">\n                                <div class=\"mb-4 flex justify-between text-[#766d88]\" data-kid=\"1-2-3-1-2-2-2-4-1\" data-name=\"backoff visualization header\">\n                                    <span data-kid=\"1-2-3-1-2-2-2-4-1-1\" data-name=\"backoff label 1\">\n                                        attempt\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-2-4-1-2\" data-name=\"backoff label 2\">\n                                        next run\n                                    </span>\n                                </div>\n                                <div class=\"space-y-3 text-[#aaa4b8]\" data-kid=\"1-2-3-1-2-2-2-4-2\" data-name=\"backoff attempts list\">\n                                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-2-2-4-2-1\" data-name=\"backoff attempt 1\">\n                                        <span class=\"w-8 text-[#c4f542]\" data-kid=\"1-2-3-1-2-2-2-4-2-1-1\" data-name=\"backoff attempt 1 number\">\n                                            01\n                                        </span>\n                                        <span class=\"h-px flex-1 bg-[#3d3356]\" data-kid=\"1-2-3-1-2-2-2-4-2-1-2\" data-name=\"backoff attempt 1 progress\">\n                                        </span>\n                                        <span data-kid=\"1-2-3-1-2-2-2-4-2-1-3\" data-name=\"backoff attempt 1 time\">\n                                            2s\n                                        </span>\n                                    </div>\n                                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-2-2-4-2-2\" data-name=\"backoff attempt 2\">\n                                        <span class=\"w-8 text-[#c4f542]\" data-kid=\"1-2-3-1-2-2-2-4-2-2-1\" data-name=\"backoff attempt 2 number\">\n                                            02\n                                        </span>\n                                        <span class=\"h-px flex-1 bg-[#3d3356]\" data-kid=\"1-2-3-1-2-2-2-4-2-2-2\" data-name=\"backoff attempt 2 progress\">\n                                        </span>\n                                        <span data-kid=\"1-2-3-1-2-2-2-4-2-2-3\" data-name=\"backoff attempt 2 time\">\n                                            4s\n                                        </span>\n                                    </div>\n                                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-2-2-4-2-3\" data-name=\"backoff attempt 3\">\n                                        <span class=\"w-8 text-[#c4f542]\" data-kid=\"1-2-3-1-2-2-2-4-2-3-1\" data-name=\"backoff attempt 3 number\">\n                                            03\n                                        </span>\n                                        <span class=\"h-px flex-1 bg-[#3d3356]\" data-kid=\"1-2-3-1-2-2-2-4-2-3-2\" data-name=\"backoff attempt 3 progress\">\n                                        </span>\n                                        <span data-kid=\"1-2-3-1-2-2-2-4-2-3-3\" data-name=\"backoff attempt 3 time\">\n                                            8s\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"mt-5 border-t hairline pt-4 text-[#766d88]\" data-kid=\"1-2-3-1-2-2-2-4-3\" data-name=\"backoff footer\">\n                                    idempotency_key: evt_42\n                                </div>\n                            </div>\n                        </article>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"ai-title\" class=\"scroll-mt-24 border-t hairline px-6 py-28 lg:px-8\" data-kid=\"1-2-4\" data-name=\"observation section\" id=\"traces\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-4-1\" data-name=\"observation content wrapper\">\n                <div class=\"mb-12 flex flex-wrap items-end justify-between gap-8\" data-kid=\"1-2-4-1-1\" data-name=\"observation section header\">\n                    <div data-kid=\"1-2-4-1-1-1\" data-name=\"observation section intro\">\n                        <div class=\"mb-5 font-mono text-xs uppercase tracking-[0.18em] text-[#766d88]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"observation category\">\n                            05 / transform + observe\n                        </div>\n                        <div class=\"section-rule mb-5 h-px w-24 bg-[#c4f542]\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"observation decorative rule\">\n                        </div>\n                        <h2 class=\"font-mono text-4xl font-bold tracking-[-0.04em] sm:text-5xl\" data-kid=\"1-2-4-1-1-1-3\" data-name=\"observation headline\" id=\"ai-title\">\n                            Make every step inspectable.\n                        </h2>\n                    </div>\n                    <p class=\"max-w-sm font-sans text-sm leading-6 text-[#aaa4b8]\" data-kid=\"1-2-4-1-1-2\" data-name=\"observation description\">\n                        The AI step is just another durable node. Its inputs, output, and execution trace stay visible.\n                    </p>\n                </div>\n                <div class=\"grid border-2 hairline lg:grid-cols-2\" data-kid=\"1-2-4-1-2\" data-name=\"observation grid\">\n                    <div class=\"border-b hairline p-8 lg:border-b-0 lg:border-r lg:p-12\" data-kid=\"1-2-4-1-2-1\" data-name=\"ai observation card\">\n                        <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"ai observation header\">\n                            <span class=\"font-mono text-xs uppercase tracking-[0.16em] text-[#766d88]\" data-kid=\"1-2-4-1-2-1-1-1\" data-name=\"ai category\">\n                                AI step / OpenRouter\n                            </span>\n                            <span class=\"border hairline px-2 py-1 font-mono text-xs text-[#aaa4b8]\" data-kid=\"1-2-4-1-2-1-1-2\" data-name=\"ai badge\">\n                                structured output\n                            </span>\n                        </div>\n                        <p class=\"mt-8 max-w-lg text-lg leading-8 text-[#aaa4b8]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"ai description\">\n                            Transform unstructured input with an LLM while preserving the surrounding execution context.\n                        </p>\n                        <pre class=\"mt-10 overflow-x-auto border hairline bg-[#2d2640]/25 p-5 font-mono text-xs leading-6\" data-kid=\"1-2-4-1-2-1-3\" data-name=\"ai code block\"><code data-kid=\"1-2-4-1-2-1-3-1\" data-name=\"ai code snippet\"><span class=\"text-[#766d88]\" data-kid=\"1-2-4-1-2-1-3-1-1\" data-name=\"ai comment 1\">// input</span>\n<span class=\"text-[#c4f542]\" data-kid=\"1-2-4-1-2-1-3-1-2\" data-name=\"ai input text\">\"Summarize ticket and extract product IDs\"</span>\n\n<span class=\"text-[#766d88]\" data-kid=\"1-2-4-1-2-1-3-1-3\" data-name=\"ai comment 2\">// output</span>\n{\n  <span class=\"text-[#7fa7ff]\" data-kid=\"1-2-4-1-2-1-3-1-4\" data-name=\"ai result structure\">\"sentiment\"</span>: <span class=\"text-[#c4f542]\" data-kid=\"1-2-4-1-2-1-3-1-5\" data-name=\"ai result property sentiment\">\"critical\"</span>,\n  <span class=\"text-[#7fa7ff]\" data-kid=\"1-2-4-1-2-1-3-1-6\" data-name=\"ai result property tags\">\"tags\"</span>: [<span class=\"text-[#c4f542]\" data-kid=\"1-2-4-1-2-1-3-1-7\" data-name=\"ai result tag 1\">\"refund\"</span>, <span class=\"text-[#c4f542]\" data-kid=\"1-2-4-1-2-1-3-1-8\" data-name=\"ai result tag 2\">\"billing\"</span>],\n  <span class=\"text-[#7fa7ff]\" data-kid=\"1-2-4-1-2-1-3-1-9\" data-name=\"ai result property products\">\"product_ids\"</span>: [<span class=\"text-[#c4f542]\" data-kid=\"1-2-4-1-2-1-3-1-10\" data-name=\"ai result product id\">\"PROD-882\"</span>]\n}</code></pre>\n                    </div>\n                    <div class=\"flex min-h-[510px] flex-col bg-[#2d2640]/10\" data-kid=\"1-2-4-1-2-2\" data-name=\"traces observation card\">\n                        <div class=\"flex items-center justify-between border-b hairline bg-[#2d2640]/25 px-6 py-5\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"traces header\">\n                            <span class=\"font-mono text-xs uppercase tracking-[0.16em] text-[#766d88]\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"traces label\">\n                                Example execution trace\n                            </span>\n                            <span class=\"border border-[#c4f542]/45 px-2 py-1 font-mono text-xs text-[#c4f542]\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"trace identifier badge\">\n                                demo_88192a\n                            </span>\n                        </div>\n                        <div class=\"custom-scrollbar flex-1 space-y-7 overflow-y-auto p-7 font-mono text-xs\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"trace logs list\">\n                            <div class=\"trace-row grid gap-3 border-b hairline pb-5 sm:grid-cols-[86px_1fr]\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"log row 1\">\n                                <span class=\"text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-1-1\" data-name=\"log timestamp 1\">\n                                    14:20:01.2\n                                </span>\n                                <div data-kid=\"1-2-4-1-2-2-2-1-2\" data-name=\"log content 1\">\n                                    <div class=\"text-[#c4f542]\" data-kid=\"1-2-4-1-2-2-2-1-2-1\" data-name=\"log event header 1\">\n                                        <span class=\"mr-2\" data-kid=\"1-2-4-1-2-2-2-1-2-1-1\" data-name=\"log bullet 1\">\n                                            ■\n                                        </span>\n                                        JOB_QUEUED / bullmq.main\n                                    </div>\n                                    <div class=\"mt-2 pl-4 text-xs leading-5 text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-1-2-2\" data-name=\"log event detail 1\">\n                                        attempt: 1 · lock: acquired\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"trace-row grid gap-3 border-b hairline pb-5 sm:grid-cols-[86px_1fr]\" data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"log row 2\">\n                                <span class=\"text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-2-1\" data-name=\"log timestamp 2\">\n                                    14:20:02.8\n                                </span>\n                                <div data-kid=\"1-2-4-1-2-2-2-2-2\" data-name=\"log content 2\">\n                                    <div class=\"text-[#7fa7ff]\" data-kid=\"1-2-4-1-2-2-2-2-2-1\" data-name=\"log event header 2\">\n                                        <span class=\"mr-2\" data-kid=\"1-2-4-1-2-2-2-2-2-1-1\" data-name=\"log bullet 2\">\n                                            ■\n                                        </span>\n                                        BRANCH_EVAL / is_valid_payload\n                                    </div>\n                                    <div class=\"mt-2 pl-4 text-xs leading-5 text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-2-2-2\" data-name=\"log event detail 2\">\n                                        result: true · target: delay.wait_10m\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"trace-row grid gap-3 border-b hairline pb-5 sm:grid-cols-[86px_1fr]\" data-kid=\"1-2-4-1-2-2-2-3\" data-name=\"log row 3\">\n                                <span class=\"text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-3-1\" data-name=\"log timestamp 3\">\n                                    14:20:02.9\n                                </span>\n                                <div data-kid=\"1-2-4-1-2-2-2-3-2\" data-name=\"log content 3\">\n                                    <div class=\"text-[#e5b84b]\" data-kid=\"1-2-4-1-2-2-2-3-2-1\" data-name=\"log event header 3\">\n                                        <span class=\"mr-2\" data-kid=\"1-2-4-1-2-2-2-3-2-1-1\" data-name=\"log bullet 3\">\n                                            ■\n                                        </span>\n                                        PERSISTENCE_SYNC / postgres\n                                    </div>\n                                    <div class=\"mt-2 pl-4 text-xs leading-5 text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-3-2-2\" data-name=\"log event detail 3\">\n                                        state saved · resume_at: 14:30:00\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"trace-row grid gap-3 sm:grid-cols-[86px_1fr]\" data-kid=\"1-2-4-1-2-2-2-4\" data-name=\"log row 4\">\n                                <span class=\"text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-4-1\" data-name=\"log timestamp 4\">\n                                    14:30:00.1\n                                </span>\n                                <div data-kid=\"1-2-4-1-2-2-2-4-2\" data-name=\"log content 4\">\n                                    <div class=\"text-[#c4f542]\" data-kid=\"1-2-4-1-2-2-2-4-2-1\" data-name=\"log event header 4\">\n                                        <span class=\"mr-2\" data-kid=\"1-2-4-1-2-2-2-4-2-1-1\" data-name=\"log bullet 4\">\n                                            ■\n                                        </span>\n                                        AI_TRANSFORM / openrouter\n                                    </div>\n                                    <div class=\"mt-2 pl-4 text-xs leading-5 text-[#766d88]\" data-kid=\"1-2-4-1-2-2-2-4-2-2\" data-name=\"log event detail 4\">\n                                        output schema validated · step complete\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"border-t hairline px-6 py-5 font-mono text-xs leading-5 text-[#766d88]\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"traces footer\">\n                            Sample trace for illustration. Production history is emitted by your Flowline worker.\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-title\" class=\"scroll-mt-24 border-t hairline px-6 py-36 text-center lg:px-8\" data-kid=\"1-2-5\" data-name=\"cta section\" id=\"get-started\">\n            <div class=\"pointer-events-none absolute left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-[#c4f542]/[0.03] blur-3xl\" data-kid=\"1-2-5-1\" data-name=\"cta decorative glow\">\n            </div>\n            <div class=\"relative mx-auto max-w-3xl\" data-kid=\"1-2-5-2\" data-name=\"cta content wrapper\">\n                <div class=\"mb-6 font-mono text-xs uppercase tracking-[0.18em] text-[#766d88]\" data-kid=\"1-2-5-2-1\" data-name=\"cta section category\">\n                    06 / deploy your first worker\n                </div>\n                <h2 class=\"font-mono text-5xl font-black leading-[0.88] tracking-[-0.06em] sm:text-7xl\" data-kid=\"1-2-5-2-2\" data-name=\"cta headline\" id=\"cta-title\">\n                    Build workflows\n                    <br data-kid=\"1-2-5-2-2-1\" data-name=\"cta headline line break\"/>\n                    <span class=\"text-[#c4f542]\" data-kid=\"1-2-5-2-2-2\" data-name=\"cta headline highlight\">\n                        that keep state.\n                    </span>\n                </h2>\n                <p class=\"mx-auto mt-8 max-w-xl text-lg leading-8 text-[#aaa4b8]\" data-kid=\"1-2-5-2-3\" data-name=\"cta description\">\n                    Bring durable orchestration to your private infrastructure with a Node.js engine you can inspect from trigger to trace.\n                </p>\n                <div class=\"mt-10 flex flex-col items-center justify-center gap-5 sm:flex-row\" data-kid=\"1-2-5-2-4\" data-name=\"cta button group\">\n                    <a class=\"primary-action inline-flex bg-[#c4f542] px-8 py-4 font-mono text-sm font-bold uppercase tracking-[0.12em] text-[#1a1625]\" data-kid=\"1-2-5-2-4-1\" data-name=\"cta primary get started button\" href=\"#top\">\n                        Get started\n                    </a>\n                    <a class=\"secondary-action inline-flex border hairline px-8 py-4 font-mono text-sm uppercase tracking-[0.12em] text-[#aaa4b8]\" data-kid=\"1-2-5-2-4-2\" data-name=\"cta secondary work button\" href=\"#diagram\">\n                        See how it works\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t hairline px-6 py-10 lg:px-8\" data-kid=\"1-3\" data-name=\"footer section\" id=\"docs\">\n        <div class=\"mx-auto flex max-w-7xl flex-col justify-between gap-6 font-mono text-xs uppercase tracking-[0.12em] text-[#766d88] md:flex-row md:items-center\" data-kid=\"1-3-1\" data-name=\"footer content layout\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1\" data-name=\"footer branding\">\n                <span class=\"flex h-5 w-5 items-center justify-center bg-[#2d2640] text-[10px] text-[#c4f542]\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo icon\">\n                    F\n                </span>\n                <span class=\"text-[#aaa4b8]\" data-kid=\"1-3-1-1-2\" data-name=\"footer brand name\">\n                    Flowline\n                </span>\n                <span data-kid=\"1-3-1-1-3\" data-name=\"version identifier\">\n                    v0.9.4 / engine core\n                </span>\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <a class=\"interactive-link\" data-kid=\"1-3-1-2-1\" data-name=\"footer engine link\" href=\"#engine\">\n                    Engine\n                </a>\n                <a class=\"interactive-link\" data-kid=\"1-3-1-2-2\" data-name=\"footer traces link\" href=\"#traces\">\n                    Traces\n                </a>\n                <a class=\"interactive-link\" data-kid=\"1-3-1-2-3\" data-name=\"footer back to top link\" href=\"#top\">\n                    Back to top\n                </a>\n            </div>\n            <span data-kid=\"1-3-1-3\" data-name=\"footer technology stack\">\n                Node.js · BullMQ · PostgreSQL\n            </span>\n        </div>\n    </footer>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n    </script>\n    <script>\n        (() => {\n        const initFlowlineMotion = () => {\n          const demoToggle = document.getElementById('demo-toggle');\n          const packet = document.getElementById('flow-packet');\n          const progress = document.getElementById('trigger-progress');\n          const paths = [\n            document.getElementById('path-trigger-branch'),\n            document.getElementById('path-branch-delay'),\n            document.getElementById('path-delay-ai')\n          ];\n          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n          if (!demoToggle || !packet || !progress || paths.some((path) => !path) || demoToggle.dataset.motionBound === 'true') return;\n          demoToggle.dataset.motionBound = 'true';\n\n          let player = null;\n          let nativeFrame = 0;\n          let playing = false;\n\n          const setDemoState = (isPlaying) => {\n            demoToggle.textContent = isPlaying ? 'Pause demo' : 'Play demo';\n            demoToggle.setAttribute('aria-pressed', String(isPlaying));\n          };\n\n          const resetDemo = () => {\n            document.querySelectorAll('.flow-node').forEach((node) => node.classList.remove('is-active'));\n            progress.style.transform = 'scaleX(0)';\n            packet.setAttribute('cx', '100');\n            packet.setAttribute('cy', '215');\n            packet.style.visibility = 'visible';\n          };\n\n          const activateNode = (id) => {\n            const node = document.getElementById(id);\n            if (node) node.classList.add('is-active');\n          };\n\n          const movePacket = (path, value) => {\n            const point = path.getPointAtLength(path.getTotalLength() * Math.max(0, Math.min(1, value)));\n            packet.setAttribute('cx', point.x.toFixed(2));\n            packet.setAttribute('cy', point.y.toFixed(2));\n          };\n\n          const finishDemo = () => {\n            playing = false;\n            player = null;\n            setDemoState(false);\n            resetDemo();\n          };\n\n          const stopNative = () => {\n            if (nativeFrame) cancelAnimationFrame(nativeFrame);\n            nativeFrame = 0;\n          };\n\n          const stopDemo = () => {\n            if (player) {\n              player.kill();\n              player = null;\n            }\n            stopNative();\n            playing = false;\n            setDemoState(false);\n            resetDemo();\n          };\n\n          const runNativeDemo = () => {\n            const segments = [\n              { kind: 'trigger', duration: 1100 },\n              { path: paths[0], duration: 650, node: 'node-branch' },\n              { path: paths[1], duration: 700, node: 'node-delay' },\n              { path: paths[2], duration: 700, node: 'node-ai' }\n            ];\n            let segmentIndex = 0;\n            let segmentStart = 0;\n\n            const frame = (now) => {\n              if (!playing) return;\n              if (!segmentStart) segmentStart = now;\n              const segment = segments[segmentIndex];\n              const elapsed = now - segmentStart;\n              const amount = Math.min(1, elapsed / segment.duration);\n\n              if (segment.kind === 'trigger') {\n                progress.style.transform = `scaleX(${amount})`;\n                activateNode('node-trigger');\n              } else {\n                movePacket(segment.path, amount);\n              }\n\n              if (amount >= 1) {\n                if (segment.node) activateNode(segment.node);\n                segmentIndex += 1;\n                segmentStart = now;\n              if (segmentIndex >= segments.length) {\n                  resetDemo();\n                  segmentIndex = 0;\n                  segmentStart = now;\n                }\n              }\n              nativeFrame = requestAnimationFrame(frame);\n            };\n\n            nativeFrame = requestAnimationFrame(frame);\n          };\n\n          const runGsapDemo = () => {\n            const animation = window.gsap;\n            const pathTween = (path, duration) => {\n              const state = { value: 0 };\n              return animation.to(state, {\n                value: 1,\n                duration,\n                ease: 'none',\n                onUpdate: () => movePacket(path, state.value)\n              });\n            };\n\n            player = animation.timeline({\n              paused: true,\n              repeat: -1,\n              repeatDelay: 0.65,\n              onRepeat: resetDemo\n            });\n            player\n              .call(() => activateNode('node-trigger'))\n              .to(progress, { scaleX: 1, duration: 1.1, ease: 'none' })\n              .add(pathTween(paths[0], 0.65))\n              .call(() => activateNode('node-branch'))\n              .add(pathTween(paths[1], 0.7))\n              .call(() => activateNode('node-delay'))\n              .add(pathTween(paths[2], 0.7))\n              .call(() => activateNode('node-ai'))\n              .to(packet, { attr: { r: 7 }, duration: 0.22, yoyo: true, repeat: 1, ease: 'sine.inOut' })\n              .to({}, { duration: 0.45 });\n            player.play(0);\n          };\n\n          const startDemo = () => {\n            stopDemo();\n            if (reduceMotion) {\n              activateNode('node-trigger');\n              packet.style.visibility = 'hidden';\n              setDemoState(false);\n              return;\n            }\n            playing = true;\n            setDemoState(true);\n            if (window.gsap && typeof window.gsap.timeline === 'function') runGsapDemo();\n            else runNativeDemo();\n          };\n\n          demoToggle.addEventListener('click', () => {\n            if (playing) stopDemo();\n            else startDemo();\n          });\n\n          if (window.gsap && window.ScrollTrigger) window.gsap.registerPlugin(window.ScrollTrigger);\n          if (window.gsap) {\n            document.querySelectorAll('.section-rule').forEach((rule) => {\n              window.gsap.to(rule, {\n                scaleX: 1,\n                duration: 0.7,\n                ease: 'power2.out',\n                scrollTrigger: window.ScrollTrigger ? { trigger: rule, start: 'top 84%', once: true } : undefined\n              });\n            });\n          } else {\n            document.querySelectorAll('.section-rule').forEach((rule) => { rule.style.transform = 'scaleX(1)'; });\n          }\n\n          document.querySelectorAll('a[href^=\"#\"]').forEach((link) => {\n            link.addEventListener('click', (event) => {\n              const target = document.querySelector(link.getAttribute('href'));\n              if (!target) return;\n              event.preventDefault();\n              target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });\n            });\n          });\n\n          resetDemo();\n          if (reduceMotion) {\n            activateNode('node-trigger');\n            packet.style.visibility = 'hidden';\n            setDemoState(false);\n          } else {\n            setDemoState(false);\n            window.setTimeout(startDemo, 650);\n          }\n        };\n\n        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initFlowlineMotion, { once: true });\n        else initFlowlineMotion();\n      })();\n    </script>\n</div>\n",
