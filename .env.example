# Flowline environment variables. Copy the parts you need:
#   apps/server/.env   - API (and the worker too when using `npm run start:all`)
#   apps/worker/.env   - worker, when run on its own
#   apps/web/.env.local (or Vercel project settings) - frontend
# Never commit real values.

# ── Server + worker ─────────────────────────────────────────────
NODE_ENV=development                 # "production" on Render: enables the strict checks below
DATABASE_URL=postgresql://user:password@localhost:5432/flowline
REDIS_URL=redis://localhost:6380     # required in production (Render Key Value internal URL)
# 32 random bytes; SAME value for server and worker. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Server only ─────────────────────────────────────────────────
JWT_SECRET=                          # long random string
PORT=4000                            # Render sets this automatically
# Frontend origin(s) allowed by CORS; the first one is where OAuth sends users back.
FRONTEND_URL=http://localhost:3000   # e.g. https://your-app.vercel.app

# OAuth apps. Redirect URIs must match the ones registered with each provider:
#   <API URL>/connections/github/callback, /connections/gmail/callback, /connections/slack/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/connections/github/callback
GOOGLE_CLIENT_ID=                    # also needed by the worker (refreshes Gmail tokens)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/connections/gmail/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/connections/slack/callback

# ── Worker only (optional) ──────────────────────────────────────
OPENROUTER_API_KEY=                  # only for AI steps
# POLL_CYCLE_MS=300000               # how often polling triggers check for new items
# HTTP_STEP_ALLOW_PRIVATE=false      # allow HTTP steps to call private/internal addresses (default: dev yes, prod no)
# WORKER_SHUTDOWN_TIMEOUT_MS=15000

# ── Web (Next.js) ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000   # e.g. https://flowline-api.onrender.com
